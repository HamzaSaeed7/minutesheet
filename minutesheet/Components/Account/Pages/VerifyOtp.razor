@page "/Account/VerifyOtp"

@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Identity
@using minutesheet.Components.Account
@using minutesheet.Data

@inject UserManager<ApplicationUser> UserManager
@inject SignInManager<ApplicationUser> SignInManager
@inject SmtpEmailSender EmailSender
@inject ILogger<VerifyOtp> Logger
@inject IdentityRedirectManager RedirectManager

<PageTitle>Verify email</PageTitle>

<h1 class="auth-title">Verify your email</h1>
<p class="auth-subtitle">We sent a 6-digit code to <strong>@Email</strong>. Enter it below to activate your account.</p>

<StatusMessage Message="@Message" />

<EditForm Model="Input" method="post" OnValidSubmit="VerifyCode" FormName="verify-otp">
    <DataAnnotationsValidator />
    <ValidationSummary class="text-danger" role="alert" />

    <div class="form-floating mb-3">
        <InputText @bind-Value="Input.Code" class="form-control otp-input" autocomplete="one-time-code"
                   inputmode="numeric" maxlength="6" aria-required="true" placeholder="000000" />
        <label>Verification code</label>
        <ValidationMessage For="() => Input.Code" class="text-danger" />
    </div>

    <button type="submit" class="w-100 btn btn-lg btn-primary">Verify &amp; continue</button>
</EditForm>

<EditForm Model="Resend" method="post" OnValidSubmit="ResendCode" FormName="resend-otp" class="mt-2">
    <button type="submit" class="w-100 btn btn-link">Resend code</button>
</EditForm>

<hr />

<!-- TEMPORARY: bypasses email verification for testing while SMTP is unavailable. Remove before production. -->
<EditForm Model="Dev" method="post" OnValidSubmit="DevVerify" FormName="dev-verify" class="mt-2">
    <button type="submit" class="w-100 btn btn-outline-secondary">Verify now (skip email — temporary)</button>
</EditForm>

<form action="Account/Logout" method="post" class="mt-2">
    <AntiforgeryToken />
    <input type="hidden" name="ReturnUrl" value="Account/Login" />
    <button type="submit" class="w-100 btn btn-link text-danger">Log out</button>
</form>

@code {
    private const string Purpose = "email-verification";

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    // Note: with multiple forms on one page, Blazor SSR sets the non-submitted
    // forms' [SupplyParameterFromForm] models to null during a POST, which would
    // make their <EditForm Model="..."> throw. Null-coalescing setters keep every
    // model non-null so all three forms always render.
    private InputModel _input = new();
    [SupplyParameterFromForm(FormName = "verify-otp")]
    private InputModel Input { get => _input; set => _input = value ?? new(); }

    private ResendModel _resend = new();
    [SupplyParameterFromForm(FormName = "resend-otp")]
    private ResendModel Resend { get => _resend; set => _resend = value ?? new(); }

    private ResendModel _dev = new();
    [SupplyParameterFromForm(FormName = "dev-verify")]
    private ResendModel Dev { get => _dev; set => _dev = value ?? new(); }

    [SupplyParameterFromQuery]
    private string? Email { get; set; }

    private string? Message { get; set; }

    private async Task<ApplicationUser?> ResolveUserAsync()
    {
        if (string.IsNullOrWhiteSpace(Email))
        {
            RedirectManager.RedirectTo("Account/Register");
        }

        var user = await UserManager.FindByEmailAsync(Email!);
        if (user is null)
        {
            Message = "Error: We couldn't find an account for that email.";
        }
        return user;
    }

    private async Task VerifyCode()
    {
        var user = await ResolveUserAsync();
        if (user is null)
        {
            return;
        }

        if (user.EmailConfirmed)
        {
            RedirectManager.RedirectTo("Account/Login");
        }

        var valid = await UserManager.VerifyUserTokenAsync(
            user, TokenOptions.DefaultEmailProvider, Purpose, Input.Code.Trim());

        if (!valid)
        {
            Message = "Error: That code is invalid or has expired. Request a new one.";
            return;
        }

        user.EmailConfirmed = true;
        var result = await UserManager.UpdateAsync(user);
        if (!result.Succeeded)
        {
            Message = $"Error: {string.Join(", ", result.Errors.Select(e => e.Description))}";
            return;
        }

        Logger.LogInformation("User {Email} verified their email via OTP.", Email);
        await SignInManager.SignInAsync(user, isPersistent: false);
        RedirectManager.RedirectTo("");
    }

    // TEMPORARY: confirms the account without a code so testing can continue
    // while email delivery is unavailable. Remove before production.
    private async Task DevVerify()
    {
        var user = await ResolveUserAsync();
        if (user is null)
        {
            return;
        }

        if (!user.EmailConfirmed)
        {
            user.EmailConfirmed = true;
            var result = await UserManager.UpdateAsync(user);
            if (!result.Succeeded)
            {
                Message = $"Error: {string.Join(", ", result.Errors.Select(e => e.Description))}";
                return;
            }
        }

        Logger.LogWarning("User {Email} verified via TEMPORARY skip-email button.", Email);
        await SignInManager.SignInAsync(user, isPersistent: false);
        RedirectManager.RedirectTo("");
    }

    private async Task ResendCode()
    {
        var user = await ResolveUserAsync();
        if (user is null)
        {
            return;
        }

        var code = await UserManager.GenerateUserTokenAsync(user, TokenOptions.DefaultEmailProvider, Purpose);
        var sent = await EmailSender.SendOtpAsync(Email!, code);
        Message = sent
            ? "A new verification code has been sent to your email."
            : "Error: We couldn't send the email right now. Please try again in a moment.";
    }

    private sealed class InputModel
    {
        [Required]
        [RegularExpression(@"^\d{6}$", ErrorMessage = "Enter the 6-digit code.")]
        [Display(Name = "Verification code")]
        public string Code { get; set; } = "";
    }

    private sealed class ResendModel
    {
    }
}
