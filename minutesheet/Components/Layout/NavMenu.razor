@implements IDisposable
@rendermode InteractiveServer

@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using minutesheet.Data

@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthStateProvider
@inject UserManager<ApplicationUser> UserManager
@inject IConfiguration Configuration
<style>
    /* ---------- Sidebar collapse / expand ---------- */
    .sb-brand {
        display: flex;
        align-items: center;
        gap: 8px;
        min-width: 0;
        position: relative; /* anchor for the side arrow tab */
        white-space: nowrap;
    }

    .sb-logo {
        flex-shrink: 0;
    }

    .sb-title {
        white-space: nowrap;
        overflow: hidden;
        min-width: 0;
        flex: 1 1 auto;
    }

    .sb-fold {
        width: 26px;
        height: 26px;
        border-radius: 50%;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        border: 1px solid rgba(255, 255, 255, .35);
        /* opaque: half the chip overhangs the sidebar onto the light page,
           so a translucent fill would disappear on that side */
        background: #14173a;
        color: #fff;
        cursor: pointer;
        transition: background .2s ease, transform .2s ease;
        /* sits on the side edge of the sidebar, out of the text's flex flow */
        position: absolute;
        right: -13px;
        top: 50%;
        transform: translateY(-50%);
        z-index: 10;
    }

        .sb-fold:hover {
            background: #262a5c;
        }

    .page > .sidebar {
        transition: width .25s ease;
    }

    /* Collapse/expand only applies on desktop (>= 992px). On mobile &
       tablet the top header must stay fixed and static regardless of the
       desktop collapse state, so the collapse rules below are desktop-only. */
    @@media (min-width: 992px) {
        /* Collapsed = the sidebar shrinks to a narrow icon-only rail.
           Driven purely by :has(), no JS interop / body class needed. */
        .page > .sidebar:has(.sb.sb-collapsed) {
            width: 76px !important;
        }

    .sb.sb-collapsed .sb-brand {
        flex-direction: column;
        justify-content: center;
        gap: 10px;
        padding: 16px 0 14px;
        min-height: 40px;
    }

    .sb.sb-collapsed .sb-logo {
        display: flex;
        justify-content: center;
        width: 100%;
    }

        .sb.sb-collapsed .sb-logo img {
            height: auto !important;
            width: 34px !important;
            object-fit: contain;
        }

    .sb.sb-collapsed .sb-title {
        display: none;
    }

    .sb.sb-collapsed .sb-fold {
        position: static;
        transform: none;
        margin: 0 auto;
    }

    .sb.sb-collapsed .navbar-toggler {
        display: none !important;
    }

    /* Nav links: keep icons, hide the text labels */
    .sb.sb-collapsed .sb-link {
        justify-content: center;
        gap: 0;
        padding-left: 0;
        padding-right: 0;
        position: relative;
    }

        .sb.sb-collapsed .sb-link span {
            display: none;
        }

    /* Pending-count badge shrinks to a small dot instead of disappearing */
    .sb.sb-collapsed .sb-badge {
        position: absolute;
        top: 2px;
        right: 14px;
        min-width: 8px;
        width: 8px;
        height: 8px;
        padding: 0;
        font-size: 0;
        border-radius: 50%;
    }

    .sb.sb-collapsed .sb-section-divider {
        display: none;
    }

    .sb.sb-collapsed .sb-user {
        justify-content: center;
        padding-left: 0;
        padding-right: 0;
    }

    .sb.sb-collapsed .sb-user-info {
        display: none;
    }

    .sb.sb-collapsed .sb-logout {
        justify-content: center;
        gap: 0;
        padding-left: 0;
        padding-right: 0;
    }

        .sb.sb-collapsed .sb-logout span {
            display: none;
        }
    }

    @@media (max-width: 991.98px) {
        body:has(.navbar-toggler:checked) {
            overflow: hidden !important;
        }
    }
</style>

<div class="sb @(_collapsed ? "sb-collapsed" : "")">
    <div class="sb-brand" title="Minute Sheet" style="min-width:0; gap:8px;">
        <div class="sb-logo" title="FFC — Partner in Prosperity" style="flex-shrink:0;">
            <img src="images/FFC-Logo-Blue-V3.webp" alt="FFC" style="height:26px; width:auto;" />
        </div>
        <div class="sb-title" style="white-space:nowrap; overflow:hidden; min-width:0;">Minute Sheet</div>
        <button type="button" class="sb-fold" title="@(_collapsed ? "Expand sidebar" : "Collapse sidebar")"
                @onclick="ToggleSidebar">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="@(_collapsed ? "M9 18l6-6-6-6" : "M15 18l-6-6 6-6")"></path>
            </svg>
        </button>
    </div>

    <input type="checkbox" title="Navigation menu" class="navbar-toggler" />

    <div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
        <nav class="sb-nav">
            <NavLink class="sb-link" href="" Match="NavLinkMatch.All" title="Dashboard">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="8" height="8" rx="1.5"></rect><rect x="13" y="3" width="8" height="8" rx="1.5"></rect><rect x="3" y="13" width="8" height="8" rx="1.5"></rect><rect x="13" y="13" width="8" height="8" rx="1.5"></rect></svg>
                <span>Dashboard</span>
            </NavLink>
            <NavLink class="sb-link" href="dashboard/create" title="Create New Sheet">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="3"></rect><path d="M12 8v8M8 12h8"></path></svg>
                <span>Create New Sheet</span>
            </NavLink>
            <NavLink class="sb-link" href="dashboard/history" title="History">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"></circle><path d="M12 7v5l3.5 2"></path></svg>
                <span>History</span>
            </NavLink>
            <NavLink class="sb-link" href="dashboard/actions" title="Actions">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 12l2 2 4-4"></path><circle cx="12" cy="12" r="9"></circle></svg>
                <span>Actions</span>
                @if (_pendingCount > 0)
                {
                    <span class="sb-badge">@_pendingCount</span>
                }
            </NavLink>

            <AuthorizeView Roles="Admin">
                <Authorized>
                    <div class="sb-section-divider" style="margin: 16px 16px 6px; font-size: 11px; font-weight: 700; text-transform: uppercase; color: rgba(255,255,255,0.45); letter-spacing: 0.8px;">
                        Admin
                    </div>
                    <NavLink class="sb-link" href="admin/sheets" title="All Sheets">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line></svg>
                        <span>All Sheets</span>
                    </NavLink>
                    <NavLink class="sb-link" href="admin/users" title="Users">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
                        <span>Users</span>
                    </NavLink>
                    <NavLink class="sb-link" href="admin/departments" title="Departments">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 21h18"></path><path d="M9 8h1"></path><path d="M9 12h1"></path><path d="M9 16h1"></path><path d="M14 8h1"></path><path d="M14 12h1"></path><path d="M14 16h1"></path><path d="M5 21V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16"></path></svg>
                        <span>Departments</span>
                    </NavLink>
                </Authorized>
            </AuthorizeView>
        </nav>

        <div class="sb-bottom">
            <NavLink class="sb-link" href="settings" title="Settings">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"></circle><path d="M19.4 15a1.7 1.7 0 0 0 .34 1.87l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.7 1.7 0 0 0-1.87-.34 1.7 1.7 0 0 0-1.04 1.56V21a2 2 0 0 1-4 0v-.09A1.7 1.7 0 0 0 9 19.37a1.7 1.7 0 0 0-1.87.34l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06A1.7 1.7 0 0 0 4.63 15a1.7 1.7 0 0 0-1.56-1.04H3a2 2 0 0 1 0-4h.09A1.7 1.7 0 0 0 4.63 9a1.7 1.7 0 0 0-.34-1.87l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06A1.7 1.7 0 0 0 9 4.63a1.7 1.7 0 0 0 1.04-1.56V3a2 2 0 0 1 4 0v.09a1.7 1.7 0 0 0 1.04 1.56 1.7 1.7 0 0 0 1.87-.34l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.7 1.7 0 0 0-.34 1.87V9a1.7 1.7 0 0 0 1.56 1.04H21a2 2 0 0 1 0 4h-.09A1.7 1.7 0 0 0 19.4 15z"></path></svg>
                <span>Settings</span>
            </NavLink>

            <AuthorizeView>
                <Authorized>
                    <div class="sb-user" title="@_name">
                        <div class="sb-avatar">
                            @if (!string.IsNullOrEmpty(_avatarPath))
                            {
                                <img src="/@_avatarPath" alt="Profile" />
                            }
                            else
                            {
                                @_initials
                            }
                        </div>
                        <div class="sb-user-info">
                            <div class="sb-user-name">@_name</div>
                            <div class="sb-user-desig">@_designation</div>
                        </div>
                    </div>
                    <form action="Account/Logout" method="post" class="sb-logout-form">
                        <AntiforgeryToken />
                        <input type="hidden" name="ReturnUrl" value="@currentUrl" />
                        <button type="submit" class="sb-logout" title="Logout">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4M16 17l5-5-5-5M21 12H9"></path></svg>
                            <span>Logout</span>
                        </button>
                    </form>
                </Authorized>
                <NotAuthorized>
                    <NavLink class="sb-link" href="Account/Login" title="Login">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4M10 17l5-5-5-5M15 12H3"></path></svg>
                        <span>Login</span>
                    </NavLink>
                </NotAuthorized>
            </AuthorizeView>
        </div>
    </div>
</div>

@code {
    private string? currentUrl;
    private string _name = "";
    private string _designation = "";
    private string _initials = "?";
    private string? _avatarPath;
    private int _pendingCount;
    private bool _collapsed;

    protected override async Task OnInitializedAsync()
    {
        currentUrl = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        NavigationManager.LocationChanged += OnLocationChanged;

        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var userId = UserManager.GetUserId(authState.User);
        if (userId is null)
        {
            return;
        }

        var options = new DbContextOptionsBuilder<ApplicationDbContext>()
            .UseSqlServer(Configuration.GetConnectionString("DefaultConnection"))
            .Options;
        await using var db = new ApplicationDbContext(options);

        var user = await db.Users.FirstOrDefaultAsync(u => u.Id == userId);
        if (user is not null)
        {
            _name = string.IsNullOrWhiteSpace(user.FullName) ? (user.Email ?? "") : user.FullName;
            _designation = DesignationName(user.Designation);
            _avatarPath = user.AvatarPath;
            _initials = Initials(user.FullName, user.Email);

            var email = user.Email ?? "";
            var mySteps = await db.ApprovalSteps
                .Where(s => s.ApproverEmail == email && s.Status != ApprovalStepStatus.Approved)
                .Include(s => s.MinuteSheet!).ThenInclude(m => m.ApprovalSteps)
                .ToListAsync();
            var approverPending = mySteps.Count(s => s.Status == ApprovalStepStatus.Pending && ApprovalWorkflow.IsActionable(s, s.MinuteSheet!.ApprovalSteps));

            // Also count sheets this user created that have been returned (reviewed) and need resolution.
            var returnedCount = await db.MinuteSheets
                .Where(m => m.CreatedByUserId == userId && m.ApprovalSteps.Any(s => s.Status == ApprovalStepStatus.Reviewed))
                .CountAsync();

            _pendingCount = approverPending + returnedCount;
        }
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        currentUrl = NavigationManager.ToBaseRelativePath(e.Location);
        StateHasChanged();
    }

    public void Dispose() => NavigationManager.LocationChanged -= OnLocationChanged;

    private void ToggleSidebar()
    {
        _collapsed = !_collapsed;
    }

    private static string DesignationName(Designation d)
    {
        var member = typeof(Designation).GetMember(d.ToString()).FirstOrDefault();
        var attr = member?.GetCustomAttributes(typeof(System.ComponentModel.DataAnnotations.DisplayAttribute), false)
            .FirstOrDefault() as System.ComponentModel.DataAnnotations.DisplayAttribute;
        return attr?.Name ?? d.ToString();
    }

    private static string Initials(string? fullName, string? email)
    {
        var source = !string.IsNullOrWhiteSpace(fullName) ? fullName : email ?? "";
        var parts = source.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 0) return "?";
        if (parts.Length == 1)
        {
            var w = parts[0];
            return (w.Length >= 2 ? w[..2] : w).ToUpperInvariant();
        }
        return (parts[0][..1] + parts[^1][..1]).ToUpperInvariant();
    }
}
