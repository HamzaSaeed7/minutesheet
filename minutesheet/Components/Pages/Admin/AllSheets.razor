@page "/admin/sheets"
@rendermode InteractiveServer

@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using minutesheet.Data

@attribute [Authorize(Roles = Roles.Admin)]

@inject ApplicationDbContext DbContext

<PageTitle>All Minute Sheets</PageTitle>

<ToastHost />

<div class="d-flex align-items-center justify-content-between flex-wrap gap-3 mb-3">
    <div>
        <h1 class="page-title mb-1">All Minute Sheets</h1>
        <p class="as-subtitle">Browse, search and manage every minute sheet across the organisation.</p>
    </div>
</div>

@if (_sheets is null)
{
    <div class="content-card">
        <p class="text-muted mb-0">Loading...</p>
    </div>
}
else
{
    <div class="as-stats">
        <div class="as-stat">
            <span class="as-stat-icon bg-brand">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="17" rx="3"></rect><path d="M8 2v4M16 2v4M3 9h18"></path></svg>
            </span>
            <span>
                <div class="as-stat-label">Total sheets</div>
                <div class="as-stat-value">@_sheets.Count</div>
            </span>
        </div>
        <div class="as-stat">
            <span class="as-stat-icon bg-ok">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><path d="M22 4 12 14.01l-3-3"></path></svg>
            </span>
            <span>
                <div class="as-stat-label">Approved</div>
                <div class="as-stat-value">@_sheets.Count(s => ApprovalWorkflow.StatusFor(s) == "Approved")</div>
            </span>
        </div>
        <div class="as-stat">
            <span class="as-stat-icon bg-info">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 8v4l3 3"></path><circle cx="12" cy="12" r="10"></circle></svg>
            </span>
            <span>
                <div class="as-stat-label">In review</div>
                <div class="as-stat-value">@_sheets.Count(s => ApprovalWorkflow.StatusFor(s) == "Review")</div>
            </span>
        </div>
        <div class="as-stat">
            <span class="as-stat-icon bg-wait">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><path d="M12 6v6l4 2"></path></svg>
            </span>
            <span>
                <div class="as-stat-label">Pending</div>
                <div class="as-stat-value">@_sheets.Count(s => ApprovalWorkflow.StatusFor(s) == "Pending")</div>
            </span>
        </div>
    </div>

    <div class="content-card history-card">
        @if (_sheets.Count == 0)
        {
            <div class="history-empty">
                <div class="history-empty-icon">
                    <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="3" y="4" width="18" height="17" rx="3"></rect><path d="M8 2v4M16 2v4M3 9h18"></path></svg>
                </div>
                <p class="history-empty-text">No minute sheets have been created yet.</p>
            </div>
        }
        else
        {
            <div class="history-toolbar as-toolbar">
                <div class="as-toolbar-search">
                    <div class="ht-search">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"></circle><path d="M21 21l-4.3-4.3"></path></svg>
                        <input type="text" placeholder="Search by title, creator, category, attachment..." @bind="_search" @bind:event="oninput" @bind:after="ResetFiltersPage" />
                    </div>
                    <button type="button" class="ht-clear" @onclick="ClearFilters"
                            disabled="@(_search.Length == 0 && _statusFilter.Length == 0 && _categoryFilter.Length == 0 &&
                                       _creatorFilter.Length == 0 && _confidentialFilter.Length == 0 &&
                                       _attachmentFilter.Length == 0 && _dateFrom is null && _dateTo is null)">Clear</button>
                </div>
                <div class="as-filter-row">
                    <select class="ht-select" @bind="_statusFilter" @bind:after="ResetFiltersPage">
                        <option value="">All statuses</option>
                        <option value="Approved">Approved</option>
                        <option value="Review">In review</option>
                        <option value="Pending">Pending</option>
                    </select>
                    <select class="ht-select" @bind="_categoryFilter" @bind:after="ResetFiltersPage">
                        <option value="">All categories</option>
                        <option value="Financial">Financial</option>
                        <option value="NonFinancial">Non-Financial</option>
                    </select>
                    <select class="ht-select" @bind="_creatorFilter" @bind:after="ResetFiltersPage">
                        <option value="">All creators</option>
                        @foreach (var c in _creators)
                        {
                            <option value="@c.Id">@c.Display</option>
                        }
                    </select>
                    <select class="ht-select" @bind="_confidentialFilter" @bind:after="ResetFiltersPage">
                        <option value="">Confidential: any</option>
                        <option value="Yes">Confidential only</option>
                        <option value="No">Non-confidential</option>
                    </select>
                    <select class="ht-select" @bind="_attachmentFilter" @bind:after="ResetFiltersPage">
                        <option value="">Any attachment</option>
                        <option value="Yes">With attachment</option>
                        <option value="No">No attachment</option>
                    </select>
                    <span class="ht-date-range">
                        <span class="ht-date-group">
                            <span class="ht-date-label">From</span>
                            <input type="date" class="ht-date" @bind="_dateFrom" @bind:format="yyyy-MM-dd" @bind:after="ResetFiltersPage" />
                        </span>
                        <span class="ht-date-group">
                            <span class="ht-date-label">To</span>
                            <input type="date" class="ht-date" @bind="_dateTo" @bind:format="yyyy-MM-dd" @bind:after="ResetFiltersPage" />
                        </span>
                    </span>
                </div>
            </div>

            @if (_filteredSheets.Count == 0)
            {
                <div class="history-empty">
                    <div class="history-empty-icon">
                        <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="11" cy="11" r="7"></circle><path d="M21 21l-4.3-4.3"></path></svg>
                    </div>
                    <p class="history-empty-text">No sheets match your search or filters.</p>
                </div>
            }
            else
            {
                <div class="as-table-wrap">
                    <table class="table table-hover align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Sheet</th>
                                <th>Creator</th>
                                <th>Category</th>
                                <th>Status</th>
                                <th>Approvals</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var sheet in _pagedSheets)
                            {
                                var status = ApprovalWorkflow.StatusFor(sheet);
                                var editable = sheet.ApprovalSteps.All(s => s.Status == ApprovalStepStatus.Pending)
                                               || sheet.ApprovalSteps.Any(s => s.Status == ApprovalStepStatus.Reviewed);
                                var creatorName = CreatorName(sheet);
                                var done = ApprovalWorkflow.ApprovedCount(sheet.ApprovalSteps);
                                var tot = sheet.ApprovalSteps.Count;
                                var pct = tot > 0 ? (int)Math.Round(done * 100.0 / tot) : 0;
                                <tr>
                                    <td data-label="Sheet">
                                        <div class="as-sheet-title">
                                            @(string.IsNullOrWhiteSpace(sheet.Title) ? "Untitled sheet" : sheet.Title)
                                            @if (sheet.IsConfidential)
                                            {
                                                <span class="conf-chip" title="Only the creator, listed approvers and admins can view this sheet.">Confidential</span>
                                            }
                                        </div>
                                        <div class="as-sheet-meta">@sheet.CreatedAt.ToLocalTime().ToString("dd MMM yyyy, HH:mm")</div>
                                    </td>
                                    <td data-label="Creator">
                                        <div class="avatar-wrap">
                                            <span class="avatar-mini">@Initials(creatorName)</span>
                                            <span>
                                                <div class="avatar-name">@creatorName</div>
                                                <div class="avatar-mail">@(sheet.CreatedByUser?.Email ?? "—")</div>
                                            </span>
                                        </div>
                                    </td>
                                    <td data-label="Category">
                                        <span class="cat-chip @(sheet.Category == SheetCategory.NonFinancial ? "cat-nonfin" : "cat-fin")">
                                            @(sheet.Category == SheetCategory.NonFinancial ? "Non-Financial" : "Financial")
                                        </span>
                                    </td>
                                    <td data-label="Status">
                                        <span class="status-pill @(status == "Approved" ? "status-ok" : status == "Review" ? "status-review" : "status-wait")">
                                            @(status == "Review" ? "In Review" : status)
                                        </span>
                                    </td>
                                    <td data-label="Approvals">
                                        <div class="h-progress">
                                            <span class="h-progress-bar"><span class="h-progress-fill" style="width:@(pct)%"></span></span>
                                            <span class="h-progress-count">@done / @tot</span>
                                        </div>
                                    </td>
                                    <td data-label="Actions" class="text-end">
                                        <div class="d-inline-flex align-items-center gap-2">
                                            @if (editable)
                                            {
                                                <a class="btn btn-sm btn-outline-secondary" href="dashboard/sheet/@sheet.Token/edit">Edit</a>
                                            }
                                            <a class="btn btn-sm btn-primary" href="dashboard/sheet/@sheet.Token">Open</a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                @if (_filteredSheets.Count > _pageSize)
                {
                    <div class="history-pagination as-pagination">
                        <span class="pgn-count">Showing @ShownStart–@ShownEnd of @_filteredSheets.Count</span>
                        <button type="button" class="pgn-btn" disabled="@(_pageIndex == 0)" @onclick="() => GoToPage(_pageIndex - 1)">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 18l-6-6 6-6"></path></svg>
                            <span>Prev</span>
                        </button>
                        <div class="pgn-pages">
                            @foreach (var p in PageNumbers)
                            {
                                <button type="button" class="pgn-num @(p == _pageIndex ? "active" : "")" @onclick="() => GoToPage(p)">@(p + 1)</button>
                            }
                        </div>
                        <button type="button" class="pgn-btn" disabled="@(_pageIndex >= TotalPages - 1)" @onclick="() => GoToPage(_pageIndex + 1)">
                            <span>Next</span>
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18l6-6-6-6"></path></svg>
                        </button>
                        <span class="as-perpage">Rows
                            <select class="ht-select" @bind="_pageSize" @bind:after="ResetFiltersPage">
                                <option value="10">10</option>
                                <option value="25">25</option>
                                <option value="50">50</option>
                            </select>
                        </span>
                    </div>
                }
            }
        }
    </div>
}

@code {
    private List<MinuteSheet>? _sheets;
    private List<CreatorOption> _creators = new();
    private int _pageIndex;
    private int _pageSize = 10;
    private string _search = "";
    private string _statusFilter = "";
    private string _categoryFilter = "";
    private string _creatorFilter = "";
    private string _confidentialFilter = "";
    private string _attachmentFilter = "";
    private DateTime? _dateFrom;
    private DateTime? _dateTo;

    private sealed record CreatorOption(string Id, string Display);

    private List<MinuteSheet> _filteredSheets =>
        _sheets?.Where(MatchesFilters).ToList() ?? new();

    private int TotalPages => _filteredSheets is { Count: > 0 }
        ? (int)Math.Ceiling(_filteredSheets.Count / (double)_pageSize)
        : 1;

    private IEnumerable<MinuteSheet> _pagedSheets =>
        _filteredSheets.Skip(_pageIndex * _pageSize).Take(_pageSize).ToList();

    private int ShownStart => _filteredSheets.Count > 0 ? _pageIndex * _pageSize + 1 : 0;
    private int ShownEnd => Math.Min((_pageIndex + 1) * _pageSize, _filteredSheets.Count);

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _sheets = await DbContext.MinuteSheets
            .AsNoTracking()
            .Include(m => m.CreatedByUser)
            .Include(m => m.ApprovalSteps)
            .OrderByDescending(m => m.CreatedAt)
            .ToListAsync();

        _creators = _sheets
            .Where(m => m.CreatedByUser is not null)
            .GroupBy(m => m.CreatedByUserId)
            .Select(g => g.First().CreatedByUser!)
            .OrderBy(u => u.FullName)
            .Select(u => new CreatorOption(
                u.Id,
                string.IsNullOrWhiteSpace(u.FullName) ? u.Email ?? u.Id : $"{u.FullName} ({u.Email})"))
            .ToList();
    }

    private bool MatchesFilters(MinuteSheet sheet)
    {
        if (_statusFilter.Length > 0 && ApprovalWorkflow.StatusFor(sheet) != _statusFilter)
            return false;

        if (_categoryFilter.Length > 0)
        {
            var cat = sheet.Category == SheetCategory.NonFinancial ? "NonFinancial" : "Financial";
            if (cat != _categoryFilter) return false;
        }

        if (_creatorFilter.Length > 0 && sheet.CreatedByUserId != _creatorFilter)
            return false;

        if (_confidentialFilter.Length > 0)
        {
            if (_confidentialFilter == "Yes" && !sheet.IsConfidential) return false;
            if (_confidentialFilter == "No" && sheet.IsConfidential) return false;
        }

        if (_attachmentFilter.Length > 0)
        {
            var has = !string.IsNullOrEmpty(sheet.AttachmentStoredPath);
            if (_attachmentFilter == "Yes" && !has) return false;
            if (_attachmentFilter == "No" && has) return false;
        }

        if (!InDateRange(sheet.CreatedAt)) return false;

        var term = _search.Trim();
        if (term.Length > 0)
        {
            var haystack = string.Join(" ", new[]
            {
                sheet.Title,
                sheet.Category == SheetCategory.NonFinancial ? "Non-Financial" : "Financial",
                sheet.CreatedByUser?.FullName ?? "",
                sheet.CreatedByUser?.Email ?? "",
                sheet.AttachmentFileName ?? ""
            });
            if (!haystack.Contains(term, StringComparison.OrdinalIgnoreCase)) return false;
        }

        return true;
    }

    private bool InDateRange(DateTime utcCreated)
    {
        if (_dateFrom is null && _dateTo is null) return true;

        var local = utcCreated.ToLocalTime().Date;

        if (_dateFrom is not null && local < _dateFrom.Value.Date)
            return false;

        if (_dateTo is not null && local > _dateTo.Value.Date)
            return false;

        return true;
    }

    private static string CreatorName(MinuteSheet sheet) =>
        string.IsNullOrWhiteSpace(sheet.CreatedByUser?.FullName)
            ? sheet.CreatedByUser?.Email ?? "—"
            : sheet.CreatedByUser.FullName;

    private static string Initials(string name)
    {
        if (string.IsNullOrWhiteSpace(name) || name == "—") return "?";

        var parts = name.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        var initials = parts.Length >= 2
            ? $"{parts[0][0]}{parts[^1][0]}"
            : parts[0][..Math.Min(2, parts[0].Length)];

        return initials.ToUpperInvariant();
    }

    private void ResetFiltersPage()
    {
        _pageIndex = 0;
    }

    private void ClearFilters()
    {
        _search = "";
        _statusFilter = "";
        _categoryFilter = "";
        _creatorFilter = "";
        _confidentialFilter = "";
        _attachmentFilter = "";
        _dateFrom = null;
        _dateTo = null;
        _pageIndex = 0;
    }

    private IEnumerable<int> PageNumbers
    {
        get
        {
            var pages = TotalPages;
            var current = _pageIndex;
            var start = Math.Max(0, current - 1);
            var end = Math.Min(pages - 1, start + 4);
            start = Math.Max(0, end - 4);
            for (var i = start; i <= end; i++) yield return i;
        }
    }

    private void GoToPage(int page)
    {
        if (page < 0 || page >= TotalPages) return;
        _pageIndex = page;
    }
}