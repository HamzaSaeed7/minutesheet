@page "/admin/sheets"
@rendermode InteractiveServer

@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using minutesheet.Data

@attribute [Authorize(Roles = Roles.Admin)]

@inject ApplicationDbContext DbContext

<PageTitle>All Minute Sheets</PageTitle>

<h1 class="page-title">All Minute Sheets</h1>

<ToastHost />

<div class="content-card" style="max-width:none">
    @if (_sheets is null)
    {
        <p>Loading...</p>
    }
    else if (_sheets.Count == 0)
    {
        <p class="text-muted mb-0">No minute sheets have been created yet.</p>
    }
    else
    {
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>Date</th>
                    <th>Created by</th>
                    <th>Category</th>
                    <th>Status</th>
                    <th>Approvals</th>
                    <th class="text-end"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var sheet in _sheets)
                {
                    var status = ApprovalWorkflow.StatusFor(sheet);
                    var editable = sheet.ApprovalSteps.All(s => s.Status == ApprovalStepStatus.Pending)
                                   || sheet.ApprovalSteps.Any(s => s.Status == ApprovalStepStatus.Reviewed);
                    <tr>
                        <td>@sheet.CreatedAt.ToLocalTime().ToString("dd MMM yyyy, HH:mm")</td>
                        <td>
                            @(string.IsNullOrWhiteSpace(sheet.CreatedByUser?.FullName)
                                ? sheet.CreatedByUser?.Email
                                : sheet.CreatedByUser!.FullName)
                        </td>
                        <td>@(sheet.Category == SheetCategory.NonFinancial ? "Non-Financial" : "Financial")</td>
                        <td><span class="badge @(status == "Approved" ? "bg-success" : "bg-warning")">@status</span></td>
                        <td>
                            @{
                                var done = ApprovalWorkflow.ApprovedCount(sheet.ApprovalSteps);
                                var tot = sheet.ApprovalSteps.Count;
                                var pct = tot > 0 ? (int)Math.Round(done * 100.0 / tot) : 0;
                            }
                            <div style="display:flex;align-items:center;gap:8px;">
                                <span class="progress-mini"><span style="width:@(pct)%;"></span></span>
                                <span style="font-size:12.5px;color:#565b78;">@done / @tot approved</span>
                            </div>
                        </td>
                        <td class="text-end">
                            <div class="d-inline-flex align-items-center gap-2">
                                @if (editable)
                                {
                                    <a class="btn btn-sm btn-outline-secondary" href="dashboard/sheet/@sheet.Token/edit">Edit</a>
                                }
                                <a class="btn btn-sm btn-outline-primary" href="dashboard/sheet/@sheet.Token">Open</a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

@code {
    private List<MinuteSheet>? _sheets;

    protected override async Task OnInitializedAsync()
    {
        _sheets = await DbContext.MinuteSheets
            .AsNoTracking()
            .Include(m => m.CreatedByUser)
            .Include(m => m.ApprovalSteps)
            .OrderByDescending(m => m.CreatedAt)
            .ToListAsync();
    }
}
