@page "/admin/departments"
@rendermode InteractiveServer

@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using minutesheet.Data

@attribute [Authorize(Roles = Roles.Admin)]

@inject ApplicationDbContext DbContext
@inject IJSRuntime JS
@inject minutesheet.Services.ToastService ToastService

<PageTitle>Manage Departments</PageTitle>

<ToastHost />

<div class="d-flex align-items-center justify-content-between flex-wrap gap-3 mb-3">
    <div>
        <h1 class="page-title mb-1">Manage Departments</h1>
        <p class="as-subtitle">Organisational departments and the employees assigned to them.</p>
    </div>
</div>

@if (_departments is null)
{
    <div class="content-card">
        <p class="text-muted mb-0">Loading...</p>
    </div>
}
else
{
    <div class="as-stats">
        <div class="as-stat">
            <span class="as-stat-icon bg-brand">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
            </span>
            <span>
                <div class="as-stat-label">Total departments</div>
                <div class="as-stat-value">@_departments.Count</div>
            </span>
        </div>
        <div class="as-stat">
            <span class="as-stat-icon bg-ok">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M22 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
            </span>
            <span>
                <div class="as-stat-label">Total employees</div>
                <div class="as-stat-value">@_departments.Sum(d => d.EmployeeCount)</div>
            </span>
        </div>
        <div class="as-stat">
            <span class="as-stat-icon bg-info">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 7h-9M14 17H5M12 3v18M3 21l18-18"></path><circle cx="17" cy="17" r="3"></circle></svg>
            </span>
            <span>
                <div class="as-stat-label">With employees</div>
                <div class="as-stat-value">@_departments.Count(d => d.EmployeeCount > 0)</div>
            </span>
        </div>
        <div class="as-stat">
            <span class="as-stat-icon bg-wait">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><path d="M8 12h8"></path></svg>
            </span>
            <span>
                <div class="as-stat-label">Empty</div>
                <div class="as-stat-value">@_departments.Count(d => d.EmployeeCount == 0)</div>
            </span>
        </div>
    </div>

    <div class="content-card history-card">
        @if (_error is not null)
        {
            <div class="alert alert-danger mx-3 mt-3 mb-0 py-2">@_error</div>
        }

        <div class="history-toolbar as-toolbar">
            <div class="as-toolbar-search">
                <div class="as-add">
                    <span class="as-add-label">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14"></path></svg>
                        New department
                    </span>
                    <input class="form-control" placeholder="e.g. Marketing" @bind="_newName" @bind:event="oninput"
                           @onkeydown="@(e => { if (e.Key == "Enter") return AddAsync(); return Task.CompletedTask; })" />
                    <button type="button" class="btn btn-primary" disabled="@(_busy || string.IsNullOrWhiteSpace(_newName))"
                            @onclick="AddAsync">+ Add</button>
                </div>
            </div>
        </div>

        @if (_departments.Count == 0)
        {
            <div class="history-empty">
                <div class="history-empty-icon">
                    <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M3 21h18M5 21V7l7-4 7 4v14M10 21v-6h4v6"></path></svg>
                </div>
                <p class="history-empty-text">No departments yet. Add your first one above.</p>
            </div>
        }
        else
        {
            <div class="history-toolbar as-toolbar">
                <div class="as-toolbar-search">
                    <div class="ht-search">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"></circle><path d="M21 21l-4.3-4.3"></path></svg>
                        <input type="text" placeholder="Search departments..." @bind="_search" @bind:event="oninput" @bind:after="ResetFiltersPage" />
                    </div>
                    <button type="button" class="ht-clear" @onclick="ClearFilters"
                            disabled="@(_search.Length == 0 && _occupancyFilter.Length == 0 && _sort == "name")">Clear</button>
                </div>
                <div class="as-filter-row">
                    <select class="ht-select" @bind="_occupancyFilter" @bind:after="ResetFiltersPage">
                        <option value="">All departments</option>
                        <option value="Occupied">With employees</option>
                        <option value="Empty">Empty</option>
                    </select>
                    <select class="ht-select" @bind="_sort" @bind:after="ResetFiltersPage">
                        <option value="name">Sort: Name A–Z</option>
                        <option value="empDesc">Sort: Most employees</option>
                        <option value="empAsc">Sort: Fewest employees</option>
                    </select>
                </div>
            </div>

            @if (_filtered.Count == 0)
            {
                <div class="history-empty">
                    <div class="history-empty-icon">
                        <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="11" cy="11" r="7"></circle><path d="M21 21l-4.3-4.3"></path></svg>
                    </div>
                    <p class="history-empty-text">No departments match your search or filters.</p>
                </div>
            }
            else
            {
                <div class="as-table-wrap">
                    <table class="table table-hover align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Department</th>
                                <th>Employees</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var dept in _paged)
                            {
                                <tr>
                                    <td data-label="Department">
                                        <div class="avatar-wrap">
                                            <span class="avatar-mini">@Initials(dept.Name)</span>
                                            <span>
                                                @if (_editingId == dept.Id)
                                                {
                                                    <input class="form-control form-control-sm" style="min-width:220px;" @bind="_editName" @bind:event="oninput" autofocus />
                                                }
                                                else
                                                {
                                                    <div class="as-user-name">@dept.Name</div>
                                                }
                                            </span>
                                        </div>
                                    </td>
                                    <td data-label="Employees">
                                        <span class="dept-count">
                                            <span class="dept-count-icon">
                                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
                                            </span>
                                            @dept.EmployeeCount
                                        </span>
                                    </td>
                                    <td data-label="Actions" class="text-end">
                                        <div class="d-inline-flex align-items-center gap-2">
                                            @if (_editingId == dept.Id)
                                            {
                                                <button type="button" class="btn btn-sm btn-primary" disabled="@(_busy || string.IsNullOrWhiteSpace(_editName))"
                                                        @onclick="() => SaveEditAsync(dept)">Save</button>
                                                <button type="button" class="btn btn-sm btn-outline-secondary" disabled="@_busy"
                                                        @onclick="CancelEdit">Cancel</button>
                                            }
                                            else
                                            {
                                                <button type="button" class="btn btn-sm btn-outline-secondary" disabled="@_busy"
                                                        @onclick="() => BeginEdit(dept)">Rename</button>
                                                <button type="button" class="btn btn-sm btn-outline-danger" disabled="@_busy"
                                                        @onclick="() => DeleteAsync(dept)">Delete</button>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                @if (_filtered.Count > _pageSize)
                {
                    <div class="history-pagination as-pagination">
                        <span class="pgn-count">Showing @ShownStart–@ShownEnd of @_filtered.Count</span>
                        <button type="button" class="pgn-btn" disabled="@(_pageIndex == 0)" @onclick="() => GoToPage(_pageIndex - 1)">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 18l-6-6 6-6"></path></svg>
                            <span>Prev</span>
                        </button>
                        <div class="pgn-pages">
                            @foreach (var p in PageNumbers)
                            {
                                <button type="button" class="pgn-num @(p == _pageIndex ? "active" : "")" @onclick="() => GoToPage(p)">@(p + 1)</button>
                            }
                        </div>
                        <button type="button" class="pgn-btn" disabled="@(_pageIndex >= TotalPages - 1)" @onclick="() => GoToPage(_pageIndex + 1)">
                            <span>Next</span>
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18l6-6-6-6"></path></svg>
                        </button>
                        <span class="as-perpage">Rows
                            <select class="ht-select" @bind="_pageSize" @bind:after="ResetFiltersPage">
                                <option value="10">10</option>
                                <option value="25">25</option>
                                <option value="50">50</option>
                            </select>
                        </span>
                    </div>
                }
            }
        }
    </div>
}

@code {
    private List<Department>? _departments;
    private string _newName = "";
    private int? _editingId;
    private string _editName = "";
    private bool _busy;
    private string? _error;

    private int _pageIndex;
    private int _pageSize = 10;
    private string _search = "";
    private string _occupancyFilter = "";
    private string _sort = "name";

    private IEnumerable<Department> _sorted =>
        _sort switch
        {
            "empDesc" => _departments!.OrderByDescending(d => d.EmployeeCount).ThenBy(d => d.Name),
            "empAsc" => _departments!.OrderBy(d => d.EmployeeCount).ThenBy(d => d.Name),
            _ => _departments!.OrderBy(d => d.Name)
        };

    private List<Department> _filtered =>
        _sorted.Where(MatchesFilters).ToList();

    private int TotalPages => _filtered is { Count: > 0 }
        ? (int)Math.Ceiling(_filtered.Count / (double)_pageSize)
        : 1;

    private IEnumerable<Department> _paged =>
        _filtered.Skip(_pageIndex * _pageSize).Take(_pageSize).ToList();

    private int ShownStart => _filtered.Count > 0 ? _pageIndex * _pageSize + 1 : 0;
    private int ShownEnd => Math.Min((_pageIndex + 1) * _pageSize, _filtered.Count);

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _departments = await DbContext.Departments.OrderBy(d => d.Name).ToListAsync();
        _pageIndex = 0;
    }

    private bool MatchesFilters(Department dept)
    {
        if (_occupancyFilter == "Occupied" && dept.EmployeeCount == 0) return false;
        if (_occupancyFilter == "Empty" && dept.EmployeeCount > 0) return false;

        var term = _search.Trim();
        if (term.Length > 0 && !dept.Name.Contains(term, StringComparison.OrdinalIgnoreCase))
            return false;

        return true;
    }

    private static string Initials(string name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "?";

        var parts = name.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        var initials = parts.Length >= 2
            ? $"{parts[0][0]}{parts[^1][0]}"
            : parts[0][..Math.Min(2, parts[0].Length)];

        return initials.ToUpperInvariant();
    }

    private async Task AddAsync()
    {
        _error = null;
        var name = _newName.Trim();
        if (string.IsNullOrWhiteSpace(name)) return;

        if (await DbContext.Departments.AnyAsync(d => d.Name == name))
        {
            ToastService.ShowError($"A department named \"{name}\" already exists.", "Duplicate name");
            return;
        }

        _busy = true;
        DbContext.Departments.Add(new Department { Name = name, EmployeeCount = 0 });
        await DbContext.SaveChangesAsync();
        _newName = "";
        await LoadAsync();
        _busy = false;
        ToastService.ShowSuccess($"Department \"{name}\" was added.", "Department added");
    }

    private void BeginEdit(Department dept)
    {
        _editingId = dept.Id;
        _editName = dept.Name;
        _error = null;
    }

    private void CancelEdit()
    {
        _editingId = null;
        _editName = "";
    }

    private async Task SaveEditAsync(Department dept)
    {
        _error = null;
        var name = _editName.Trim();
        if (string.IsNullOrWhiteSpace(name)) return;

        if (await DbContext.Departments.AnyAsync(d => d.Name == name && d.Id != dept.Id))
        {
            ToastService.ShowError($"A department named \"{name}\" already exists.", "Duplicate name");
            return;
        }

        _busy = true;
        var tracked = await DbContext.Departments.FirstAsync(d => d.Id == dept.Id);
        tracked.Name = name;
        await DbContext.SaveChangesAsync();
        _editingId = null;
        await LoadAsync();
        _busy = false;
        ToastService.ShowSuccess($"Department renamed to \"{name}\".", "Department renamed");
    }

    private async Task DeleteAsync(Department dept)
    {
        var confirmed = await JS.InvokeAsync<bool>("confirm",
            $"Delete \"{dept.Name}\"? Users in this department will be left without one.");
        if (!confirmed) return;

        _busy = true;
        var tracked = await DbContext.Departments.FirstOrDefaultAsync(d => d.Id == dept.Id);
        if (tracked is not null)
        {
            DbContext.Departments.Remove(tracked);
            await DbContext.SaveChangesAsync();
            await LoadAsync();
            ToastService.ShowSuccess($"Department \"{dept.Name}\" was deleted.", "Department deleted");
        }
        _busy = false;
    }

    private void ResetFiltersPage() => _pageIndex = 0;

    private void ClearFilters()
    {
        _search = "";
        _occupancyFilter = "";
        _sort = "name";
        _pageIndex = 0;
    }

    private IEnumerable<int> PageNumbers
    {
        get
        {
            var pages = TotalPages;
            var current = _pageIndex;
            var start = Math.Max(0, current - 1);
            var end = Math.Min(pages - 1, start + 4);
            start = Math.Max(0, end - 4);
            for (var i = start; i <= end; i++) yield return i;
        }
    }

    private void GoToPage(int page)
    {
        if (page < 0 || page >= TotalPages) return;
        _pageIndex = page;
    }
}