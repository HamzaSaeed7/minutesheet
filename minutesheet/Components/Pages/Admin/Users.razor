@page "/admin/users"
@rendermode InteractiveServer

@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using minutesheet.Data

@attribute [Authorize(Roles = Roles.Admin)]

@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthStateProvider
@inject minutesheet.Services.ToastService ToastService
@inject IJSRuntime JS

<PageTitle>Manage Users</PageTitle>

<ToastHost />

<div class="d-flex align-items-center justify-content-between mb-3">
    <h1 class="page-title mb-0">Manage Users</h1>
    <a class="btn btn-primary" href="admin/users/create">+ Add User</a>
</div>

<div class="content-card" style="max-width:none">
    @if (_rows is null)
    {
        <p>Loading...</p>
    }
    else if (_rows.Count == 0)
    {
        <p class="text-muted mb-0">No users found.</p>
    }
    else
    {
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Employee No.</th>
                    <th>Role</th>
                    <th class="text-end">Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in _rows)
                {
                    <tr>
                        <td>@(string.IsNullOrWhiteSpace(row.User.FullName) ? "—" : row.User.FullName)</td>
                        <td>@row.User.Email</td>
                        <td>@(string.IsNullOrWhiteSpace(row.User.EmployeeNo) ? "—" : row.User.EmployeeNo)</td>
                        <td>
                            <span class="badge @(row.IsAdmin ? "bg-primary" : "bg-secondary")">
                                @(row.IsAdmin ? Roles.Admin : Roles.Employee)
                            </span>
                        </td>
                        <td class="text-end">
                            <div class="d-inline-flex align-items-center gap-2">
                                <a class="btn btn-sm btn-outline-secondary" href="@($"admin/users/{row.User.Id}/edit")">Edit</a>
                                @if (row.IsSelf)
                                {
                                    <span class="text-muted" style="font-size:12.5px;">You</span>
                                }
                                else
                                {
                                    @if (row.IsAdmin)
                                    {
                                        <button type="button" class="btn btn-sm btn-outline-secondary" disabled="@_busy"
                                                @onclick="() => SetRole(row, makeAdmin: false)">
                                            Make Employee
                                        </button>
                                    }
                                    else
                                    {
                                        <button type="button" class="btn btn-sm btn-outline-primary" disabled="@_busy"
                                                @onclick="() => SetRole(row, makeAdmin: true)">
                                            Make Admin
                                        </button>
                                    }

                                    <button type="button" class="btn btn-sm btn-outline-danger" disabled="@_busy"
                                            @onclick="() => DeleteUserAsync(row)">
                                        Delete
                                    </button>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

@code {
    private List<UserRow>? _rows;
    private string? _currentUserId;
    private bool _busy;

    private sealed class UserRow
    {
        public required ApplicationUser User { get; init; }
        public bool IsAdmin { get; set; }
        public bool IsSelf { get; set; }
    }

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        _currentUserId = UserManager.GetUserId(authState.User);
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        var users = await UserManager.Users.OrderBy(u => u.FullName).ToListAsync();
        var rows = new List<UserRow>();
        foreach (var user in users)
        {
            rows.Add(new UserRow
            {
                User = user,
                IsAdmin = await UserManager.IsInRoleAsync(user, Roles.Admin),
                IsSelf = user.Id == _currentUserId
            });
        }
        _rows = rows;
    }

    private async Task SetRole(UserRow row, bool makeAdmin)
    {
        if (row.IsSelf) return; // guard against self-lockout
        _busy = true;

        if (makeAdmin)
        {
            await UserManager.RemoveFromRoleAsync(row.User, Roles.Employee);
            await UserManager.AddToRoleAsync(row.User, Roles.Admin);
        }
        else
        {
            await UserManager.RemoveFromRoleAsync(row.User, Roles.Admin);
            await UserManager.AddToRoleAsync(row.User, Roles.Employee);
        }

        // Force the user's principal to be rebuilt (picks up new role claims on next revalidation).
        await UserManager.UpdateSecurityStampAsync(row.User);

        row.IsAdmin = makeAdmin;
        ToastService.ShowSuccess($"{row.User.Email} is now {(makeAdmin ? Roles.Admin : Roles.Employee)}.", "Role updated");
        _busy = false;
    }

    private async Task DeleteUserAsync(UserRow row)
    {
        if (row.IsSelf) return;

        var confirmed = await JS.InvokeAsync<bool>("confirm", $"Are you sure you want to delete user '{row.User.Email}'?\n\nThis action cannot be undone.");
        if (!confirmed) return;

        _busy = true;
        try
        {
            var result = await UserManager.DeleteAsync(row.User);
            if (result.Succeeded)
            {
                ToastService.ShowSuccess($"User '{row.User.Email}' has been deleted.", "User Deleted");
                await LoadAsync();
            }
            else
            {
                var err = string.Join(", ", result.Errors.Select(e => e.Description));
                ToastService.ShowError($"Could not delete user: {err}", "Delete Failed");
            }
        }
        catch (Exception)
        {
            ToastService.ShowError("Cannot delete user who has created minute sheets or action records.", "Delete Restricted");
        }
        finally
        {
            _busy = false;
        }
    }
}
