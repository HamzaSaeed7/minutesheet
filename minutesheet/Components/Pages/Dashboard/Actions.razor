@page "/dashboard/actions"
@rendermode InteractiveServer

@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using minutesheet.Data

@attribute [Authorize]

@inject ApplicationDbContext DbContext
@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>Actions</PageTitle>

<style>
    .act-user {
        display: flex;
        align-items: center;
        gap: 9px;
        font-weight: 600;
        color: #565b78;
    }

    .min-avatar {
        width: 28px;
        height: 28px;
        border-radius: 50%;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        color: #fff;
        font-weight: 700;
        font-size: 11.5px;
        flex-shrink: 0;
    }
</style>

<h1 class="page-title">Actions</h1>

<ToastHost />

@if (_loading)
{
    <div class="content-card"><p class="mb-0">Loading...</p></div>
}
else
{
    <div class="act-section">Pending your approval</div>
    <div class="act-card" style="margin-bottom:28px;">
        @if (_pending.Count == 0)
        {
            <div class="act-empty">Nothing waiting on you right now.</div>
        }
        else
        {
            <div class="act-head" style="grid-template-columns:1.5fr 1.3fr 1.3fr 1fr 1fr 90px;">
                <div>Title</div><div>Date</div><div>From</div><div>Category</div><div>Your status</div><div></div>
            </div>
            @foreach (var step in _pending)
            {
                var sheet = step.MinuteSheet!;
                <div class="act-row" style="grid-template-columns:1.5fr 1.3fr 1.3fr 1fr 1fr 90px;">
                    <div style="font-weight:600;color:var(--ink-strong);">@sheet.Title</div>
                    <div>@sheet.CreatedAt.ToLocalTime().ToString("dd MMM yyyy, HH:mm")</div>
                    <div>
                        <div class="act-user">
                            <span class="min-avatar" style="background:@AvatarColor(sheet)">@AvatarInitials(sheet)</span>
                            <span>@CreatorName(sheet)</span>
                        </div>
                    </div>
                    <div style="color:#565b78;">@(sheet.Category == SheetCategory.NonFinancial ? "Non-Financial" : "Financial")</div>
                    <div><span class="badge @StepStatusClass(step.Status)">@DisplayName(step.Status)</span></div>
                    <div><a class="btn btn-sm btn-primary" href="dashboard/sheet/@sheet.Token">Open</a></div>
                </div>
            }
        }
    </div>

    <div class="act-section">Reviews to resolve</div>
    <div class="act-card">
        @if (_toResolve.Count == 0)
        {
            <div class="act-empty">No reviews awaiting your resolution.</div>
        }
        else
        {
            <div class="act-head" style="grid-template-columns:1.5fr 1.5fr 1fr 1fr 90px;">
                <div>Title</div><div>Date</div><div>Category</div><div>Reviews to resolve</div><div></div>
            </div>
            @foreach (var sheet in _toResolve)
            {
                var count = sheet.ApprovalSteps.Count(s => s.Status == ApprovalStepStatus.Reviewed);
                <div class="act-row" style="grid-template-columns:1.5fr 1.5fr 1fr 1fr 90px;">
                    <div style="font-weight:600;color:var(--ink-strong);">@sheet.Title</div>
                    <div>@sheet.CreatedAt.ToLocalTime().ToString("dd MMM yyyy, HH:mm")</div>
                    <div style="color:#565b78;">@(sheet.Category == SheetCategory.NonFinancial ? "Non-Financial" : "Financial")</div>
                    <div><span class="badge bg-warning">@count</span></div>
                    <div><a class="btn btn-sm btn-primary" href="dashboard/sheet/@sheet.Token">Open</a></div>
                </div>
            }
        }
    </div>

    <div class="act-section">Shared with me</div>
    <div class="act-card">
        @if (_shared.Count == 0)
        {
            <div class="act-empty">Nothing has been shared with you.</div>
        }
        else
        {
            <div class="act-head" style="grid-template-columns:1.3fr 1.3fr 1fr 1fr 90px;">
                <div>Shared</div><div>From</div><div>Category</div><div>Visibility</div><div></div>
            </div>
            @foreach (var share in _shared)
            {
                var sheet = share.MinuteSheet!;
                <div class="act-row" style="grid-template-columns:1.3fr 1.3fr 1fr 1fr 90px;">
                    <div>@share.SharedAt.ToLocalTime().ToString("dd MMM yyyy, HH:mm")</div>
                    <div style="color:#565b78;">@SharerName(share)</div>
                    <div style="color:#565b78;">@(sheet.Category == SheetCategory.NonFinancial ? "Non-Financial" : "Financial")</div>
                    <div><span class="badge @(sheet.IsConfidential ? "bg-danger" : "bg-secondary")">@(sheet.IsConfidential ? "Confidential" : "Non-confidential")</span></div>
                    <div><a class="btn btn-sm btn-primary" href="dashboard/sheet/@sheet.Token">Open</a></div>
                </div>
            }
        }
    </div>
}

@code {
    private bool _loading = true;
    private List<ApprovalStep> _pending = new();
    private List<MinuteSheet> _toResolve = new();
    private List<SheetShare> _shared = new();

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = await UserManager.GetUserAsync(authState.User);
        if (user is null)
        {
            _loading = false;
            return;
        }

        var myEmail = user.Email ?? "";

        var mySteps = await DbContext.ApprovalSteps
            .Where(s => s.ApproverEmail == myEmail && s.Status != ApprovalStepStatus.Approved)
            .Include(s => s.MinuteSheet!).ThenInclude(m => m.CreatedByUser)
            .Include(s => s.MinuteSheet!).ThenInclude(m => m.ApprovalSteps)
            .OrderByDescending(s => s.MinuteSheet!.CreatedAt)
            .ToListAsync();

        _pending = mySteps
            .Where(s => ApprovalWorkflow.IsActionable(s, s.MinuteSheet!.ApprovalSteps))
            .ToList();

        _toResolve = await DbContext.MinuteSheets
            .Where(m => m.CreatedByUserId == user.Id
                        && m.ApprovalSteps.Any(s => s.Status == ApprovalStepStatus.Reviewed))
            .Include(m => m.ApprovalSteps)
            .OrderByDescending(m => m.CreatedAt)
            .ToListAsync();

        _shared = await DbContext.SheetShares
            .Where(s => s.SharedWithEmail == myEmail)
            .Include(s => s.MinuteSheet!).ThenInclude(m => m.CreatedByUser)
            .Include(s => s.SharedByUser)
            .OrderByDescending(s => s.SharedAt)
            .ToListAsync();

        _loading = false;
    }

    private static string SharerName(SheetShare share) =>
        share.SharedByUser is null
            ? "—"
            : (string.IsNullOrWhiteSpace(share.SharedByUser.FullName) ? share.SharedByUser.Email ?? "—" : share.SharedByUser.FullName);

    private static string CreatorName(MinuteSheet sheet) =>
        sheet.CreatedByUser is null
            ? "—"
            : (string.IsNullOrWhiteSpace(sheet.CreatedByUser.FullName) ? sheet.CreatedByUser.Email ?? "—" : sheet.CreatedByUser.FullName);

    private static string AvatarInitials(MinuteSheet sheet)
    {
        if (sheet.CreatedByUser is null) return "?";
        var source = string.IsNullOrWhiteSpace(sheet.CreatedByUser.FullName)
            ? sheet.CreatedByUser.Email ?? "?"
            : sheet.CreatedByUser.FullName;
        var parts = source.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 0) return "?";
        if (parts.Length == 1)
        {
            var w = parts[0];
            return (w.Length >= 2 ? w[..2] : w).ToUpperInvariant();
        }
        return (parts[0][..1] + parts[^1][..1]).ToUpperInvariant();
    }

    private static string AvatarColor(MinuteSheet sheet)
    {
        var source = sheet.CreatedByUser is null ? "?" : (sheet.CreatedByUser.FullName ?? sheet.CreatedByUser.Email ?? "?");
        var h = Math.Abs(source.GetHashCode());
        var r = 60 + h % 140;
        var g = 60 + (h >> 8) % 140;
        var b = 60 + (h >> 16) % 140;
        return $"rgb({r},{g},{b})";
    }

    private static string DisplayName(ApprovalStepStatus s) => s switch
    {
        ApprovalStepStatus.Reviewed => "Reviewed",
        ApprovalStepStatus.Approved => "Approved",
        _ => "Pending"
    };

    private static string StepStatusClass(ApprovalStepStatus s) => s switch
    {
        ApprovalStepStatus.Approved => "bg-success",
        ApprovalStepStatus.Reviewed => "bg-warning text-dark",
        _ => "bg-secondary"
    };
}