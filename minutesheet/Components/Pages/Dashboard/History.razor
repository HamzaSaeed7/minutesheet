@page "/dashboard/history"
@rendermode InteractiveServer

@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using minutesheet.Data

@attribute [Authorize]

@inject ApplicationDbContext DbContext
@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthStateProvider
@inject IWebHostEnvironment Env
@inject IJSRuntime JS

<PageTitle>History</PageTitle>

<h1 class="page-title">Minute Sheet History</h1>

<div class="seg-tabs" style="margin-bottom:18px;">
    <button type="button" class="seg-tab @(!_showPublic ? "active" : "")" @onclick="() => SetView(false)">Private</button>
    <button type="button" class="seg-tab @(_showPublic ? "active" : "")" @onclick="() => SetView(true)">Public</button>
</div>

<div class="content-card" style="max-width:none">
    @if (_sheets is null)
    {
        <p>Loading...</p>
    }
    else if (_sheets.Count == 0)
    {
        <p class="text-muted mb-0">@(_showPublic ? "No public minute sheets available yet." : "You haven't submitted or been assigned to any minute sheets yet.")</p>
    }
    else
    {
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>Date</th>
                    @if (_showPublic)
                    {
                        <th>Created by</th>
                    }
                    <th>Category</th>
                    <th>Status</th>
                    <th>Approvals</th>
                    <th>Attachment</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var sheet in _sheets)
                {
                    var status = ApprovalWorkflow.StatusFor(sheet);
                    var mine = sheet.CreatedByUserId == _userId;
                    <tr>
                        <td>@sheet.CreatedAt.ToLocalTime().ToString("dd MMM yyyy, HH:mm")</td>
                        @if (_showPublic)
                        {
                            <td>@(string.IsNullOrWhiteSpace(sheet.CreatedByUser?.FullName) ? sheet.CreatedByUser?.Email : sheet.CreatedByUser!.FullName)</td>
                        }
                        <td>
                            @(sheet.Category == SheetCategory.NonFinancial ? "Non-Financial" : "Financial")
                            @if (sheet.IsConfidential)
                            {
                                <span class="badge bg-danger" style="margin-left:6px;" title="Only the creator, listed approvers and admins can view this sheet.">Confidential</span>
                            }
                        </td>
                        <td><span class="badge @(status == "Approved" ? "bg-success" : "bg-warning")">@status</span></td>
                        <td>
                            @{
                                var done = ApprovalWorkflow.ApprovedCount(sheet.ApprovalSteps);
                                var tot = sheet.ApprovalSteps.Count;
                                var pct = tot > 0 ? (int)Math.Round(done * 100.0 / tot) : 0;
                            }
                            <div style="display:flex;align-items:center;gap:8px;">
                                <span class="progress-mini"><span style="width:@(pct)%;"></span></span>
                                <span style="font-size:12.5px;color:#565b78;">@done / @tot approved</span>
                            </div>
                        </td>
                        <td>
                            @if (!string.IsNullOrEmpty(sheet.AttachmentStoredPath))
                            {
                                <a href="@sheet.AttachmentStoredPath" target="_blank">@sheet.AttachmentFileName</a>
                            }
                            else
                            {
                                <span class="text-muted">—</span>
                            }
                        </td>
                        <td>
                            <div class="d-flex gap-2 justify-content-end">
                                @if (mine && (sheet.ApprovalSteps.All(s => s.Status == ApprovalStepStatus.Pending)
                                     || sheet.ApprovalSteps.Any(s => s.Status == ApprovalStepStatus.Reviewed)))
                                {
                                    <a class="btn btn-sm btn-outline-secondary" href="dashboard/sheet/@sheet.Token/edit">Edit</a>
                                }
                                <a class="btn btn-sm btn-outline-primary" href="dashboard/sheet/@sheet.Token">Open</a>
                                @if (mine)
                                {
                                    <button type="button" class="btn btn-sm btn-outline-danger" disabled="@_busy" @onclick="() => DeleteSheet(sheet.Token)">Delete</button>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

@code {
    private List<MinuteSheet>? _sheets;
    private string? _userId;
    private string _userEmail = "";
    private bool _busy;
    private bool _showPublic;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = await UserManager.GetUserAsync(authState.User);
        if (user is null)
        {
            _sheets = new();
            return;
        }

        _userId = user.Id;
        _userEmail = user.Email ?? "";
        await LoadAsync();
    }

    private async Task SetView(bool showPublic)
    {
        _showPublic = showPublic;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        if (_showPublic)
        {
            // Public view: every user can browse all non-confidential sheets.
            _sheets = await DbContext.MinuteSheets
                .AsNoTracking()
                .Where(m => !m.IsConfidential)
                .Include(m => m.CreatedByUser)
                .Include(m => m.ApprovalSteps)
                .OrderByDescending(m => m.CreatedAt)
                .ToListAsync();
        }
        else
        {
            // Private view: sheets the current user created plus confidential
            // sheets where they're a listed approver (so approvers can reach
            // sheets they're involved in from history, not just Actions).
            _sheets = await DbContext.MinuteSheets
                .AsNoTracking()
                .Where(m => m.CreatedByUserId == _userId
                            || (m.IsConfidential && m.ApprovalSteps.Any(s => s.ApproverEmail == _userEmail)))
                .Include(m => m.ApprovalSteps)
                .OrderByDescending(m => m.CreatedAt)
                .ToListAsync();
        }
    }

    private async Task DeleteSheet(Guid token)
    {
        if (_userId is null) return;

        var confirmed = await JS.InvokeAsync<bool>("confirm",
            "Delete this minute sheet? This permanently removes it along with its approval steps and comments. This cannot be undone.");
        if (!confirmed) return;

        _busy = true;

        var sheet = await DbContext.MinuteSheets.FirstOrDefaultAsync(m => m.Token == token);
        if (sheet is not null && sheet.CreatedByUserId == _userId)
        {
            var attachmentPath = sheet.AttachmentStoredPath;
            DbContext.MinuteSheets.Remove(sheet);
            await DbContext.SaveChangesAsync();

            if (!string.IsNullOrEmpty(attachmentPath))
            {
                try
                {
                    var fullPath = Path.Combine(Env.WebRootPath, attachmentPath);
                    if (File.Exists(fullPath)) File.Delete(fullPath);
                }
                catch (IOException) { /* best-effort cleanup */ }
            }

            await LoadAsync();
        }

        _busy = false;
    }
}
