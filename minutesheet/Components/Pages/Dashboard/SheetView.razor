@page "/dashboard/sheet/{Token:guid}"
@rendermode InteractiveServer

@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using minutesheet.Data
@using minutesheet.Components.Account

@attribute [Authorize]

@inject IConfiguration Configuration
@inject UserManager<ApplicationUser> UserManager
@inject EmailQueue EmailQueue
@inject minutesheet.Services.SheetPdfService PdfService
@inject NavigationManager NavigationManager
@inject IWebHostEnvironment Env
@inject IJSRuntime JS
@inject minutesheet.Services.ToastService ToastService

<PageTitle>Minute Sheet</PageTitle>

<ToastHost />

@if (_loading)
{
    <h1 class="page-title">Minute Sheet</h1>
    <div class="content-card"><p class="mb-0">Loading...</p></div>
}
else if (_sheet is null)
{
    <h1 class="page-title">Minute Sheet</h1>
    <div class="content-card"><p class="text-muted mb-0">This minute sheet could not be found.</p></div>
}
else if (!_canView)
{
    <h1 class="page-title">Minute Sheet</h1>
    <div class="content-card">
        <div class="alert alert-danger mb-0">You don't have access to this minute sheet.</div>
    </div>
}
else
{
    <a href="dashboard/history" class="back-link">&larr; Back to history</a>

    <div class="content-card mb-4">
        <div class="d-flex align-items-center gap-3 mb-3">
            <div class="sheet-avatar">
                @if (!string.IsNullOrEmpty(_sheet.CreatedByUser?.AvatarPath))
                {
                    <img src="@($"/{_sheet.CreatedByUser!.AvatarPath}")" alt="Profile picture" />
                }
                else
                {
                    @Initials(_sheet.CreatedByUser?.FullName, _sheet.CreatedByUser?.Email)
                }
            </div>
            <div style="flex:1;min-width:0;">
                <div class="creator-label">Prepared by</div>
                <div class="creator-name">@(string.IsNullOrWhiteSpace(_sheet.CreatedByUser?.FullName) ? _sheet.CreatedByUser?.Email : _sheet.CreatedByUser!.FullName)</div>
                <div class="creator-meta">@CreatorMeta()</div>
            </div>
            @if (_canEdit)
            {
                <a href="dashboard/sheet/@Token/edit" class="btn btn-outline-primary btn-sm">Edit</a>
            }
            @if (_isCreator || _isApprover || _isAdmin)
            {
                <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="OpenShare">Share</button>
            }
            @if (_isCreator)
            {
                <button type="button" class="btn btn-outline-danger btn-sm" disabled="@_busy" @onclick="DeleteSheet">Delete</button>
            }
            @if (_sheet.IsConfidential)
            {
                <span class="badge bg-danger" style="font-size:13px;padding:6px 16px;" title="Only the creator, listed approvers and admins can view this sheet.">Confidential</span>
            }
            <span class="badge @SheetStatusClass(_currentStatus)" style="font-size:13px;padding:6px 16px;">@_currentStatus</span>
        </div>

        <div class="d-flex flex-wrap" style="gap:28px;padding:18px 0;border-top:1px solid #f0f1f7;border-bottom:1px solid #f0f1f7;margin-bottom:18px;">
            <div>
                <div class="creator-label mb-1">Category</div>
                <div style="font-weight:500;">@(_sheet.Category == SheetCategory.NonFinancial ? "Non-Financial" : "Financial")</div>
            </div>
            @if (_sheet.Category == SheetCategory.Financial && _sheet.Amount.HasValue)
            {
                <div>
                    <div class="creator-label mb-1">Approval Amount</div>
                    <div style="font-weight:500;">@_sheet.Currency @_sheet.Amount.Value.ToString("N2")</div>
                </div>
            }
            @if (_sheet.Department != null)
            {
                <div>
                    <div class="creator-label mb-1">Department</div>
                    <div style="font-weight:500;">@_sheet.Department.Name</div>
                </div>
            }
            <div>
                <div class="creator-label mb-1">Submitted</div>
                <div style="font-weight:500;">@_sheet.CreatedAt.ToLocalTime().ToString("dd MMM yyyy, HH:mm")</div>
            </div>
            <div>
                <div class="creator-label mb-1">Approvals</div>
                <div style="font-weight:500;">@ApprovalWorkflow.ApprovedCount(_sheet.ApprovalSteps) / @_sheet.ApprovalSteps.Count approved</div>
            </div>
        </div>

        @if (_isViewOnly)
        {
            <div class="alert alert-info mb-3">This sheet was shared with you for viewing only. You can leave a suggestion below, but you can't edit or take approval actions.</div>
        }

        @if (!string.IsNullOrEmpty(_sheet.Summary))
        {
            <div class="mb-3">
                <div class="creator-label mb-1" style="color: #000066; font-weight: 600;">Summary (AI Generated)</div>
                <div class="description-body" style="font-family: 'Poppins', sans-serif; background-color: #f8f9fa; padding: 12px; border-radius: 6px;">@_sheet.Summary</div>
            </div>
        }

        @if (!string.IsNullOrEmpty(_sheet.ActionItems))
        {
            var items = System.Text.Json.JsonSerializer.Deserialize<List<minutesheet.Services.ActionItemDto>>(_sheet.ActionItems);
            if (items != null && items.Any())
            {
                <div class="mb-3">
                    <div class="creator-label mb-1" style="color: #000066; font-weight: 600;">Action Items</div>
                    <div class="description-body" style="font-family: 'Poppins', sans-serif; background-color: #f8f9fa; padding: 12px; border-radius: 6px;">
                        <ul style="list-style: none; padding-left: 0; margin-bottom: 0;">
                            @foreach (var item in items)
                            {
                                <li style="margin-bottom: 6px;">
                                    <input type="checkbox" disabled style="margin-right: 8px;" />
                                    <strong>@item.Task</strong>
                                    @if (!string.IsNullOrEmpty(item.Owner))
                                    {
                                        <span class="text-muted" style="margin-left: 8px; font-size: 13px;">(Owner: @item.Owner)</span>
                                    }
                                    @if (!string.IsNullOrEmpty(item.Deadline))
                                    {
                                        <span class="text-muted" style="margin-left: 8px; font-size: 13px;">(Deadline: @item.Deadline)</span>
                                    }
                                </li>
                            }
                        </ul>
                    </div>
                </div>
            }
        }

        @if (!string.IsNullOrEmpty(_sheet.NextMeetingAgenda))
        {
            var agenda = System.Text.Json.JsonSerializer.Deserialize<List<minutesheet.Services.AgendaItemDto>>(_sheet.NextMeetingAgenda);
            if (agenda != null && agenda.Any())
            {
                <div class="mb-3">
                    <div class="creator-label mb-1" style="color: #000066; font-weight: 600;">Next Meeting Agenda</div>
                    <div class="description-body" style="font-family: 'Poppins', sans-serif; background-color: #f8f9fa; padding: 12px; border-radius: 6px;">
                        <ul style="list-style: none; padding-left: 0; margin-bottom: 0;">
                            @foreach (var item in agenda)
                            {
                                <li style="margin-bottom: 6px;">
                                    <strong>@item.Topic</strong>
                                    @if (!string.IsNullOrEmpty(item.Owner))
                                    {
                                        <span class="text-muted" style="margin-left: 8px; font-size: 13px;">(Owner: @item.Owner)</span>
                                    }
                                    @if (!string.IsNullOrEmpty(item.TimeBox))
                                    {
                                        <span class="text-muted" style="margin-left: 8px; font-size: 13px;">(Time: @item.TimeBox)</span>
                                    }
                                </li>
                            }
                        </ul>
                    </div>
                </div>
            }
        }

        <div class="mb-3">
            <div class="creator-label mb-1">Description</div>
            <div class="description-body">@((MarkupString)_sheet.DescriptionHtml)</div>
        </div>

        @if (!string.IsNullOrEmpty(_sheet.AttachmentStoredPath))
        {
            <div class="mb-1">
                <div class="creator-label mb-1">Attachment</div>
                <a href="/@_sheet.AttachmentStoredPath" target="_blank">@_sheet.AttachmentFileName</a>
            </div>
        }
    </div>

    @if (_showSharePanel)
    {
        <div class="content-card mb-4">
            <div class="d-flex align-items-center justify-content-between" style="margin-bottom:14px;">
                <div class="section-title mb-0">Share this minute sheet</div>
                <button type="button" class="btn-close" aria-label="Close" @onclick="CloseShare"></button>
            </div>

            <div class="mb-3" style="position:relative;">
                <label class="form-label mb-1" style="font-size:13px;font-weight:600;">Search people to share with</label>
                <input class="form-control" placeholder="Search by name, email, or employee number..."
                       value="@_shareSearch" @oninput="OnShareSearch" @onfocus="() => _showShareDropdown = true" @onblur="HideShareDropdown" />
                @if (_showShareDropdown)
                {
                    <div class="share-dropdown">
                        @if (_shareFiltered.Count == 0)
                        {
                            <div class="share-dropdown-empty">No users match your search.</div>
                        }
                        else
                        {
                            @foreach (var u in _shareFiltered)
                            {
                                var email = u.Email ?? "";
                                var already = _selectedShares.Contains(email);
                                <button type="button" class="share-dropdown-item" disabled="@already" @onmousedown="() => AddShareUser(email)">
                                    <span style="font-weight:500;font-size:13.5px;">@(string.IsNullOrWhiteSpace(u.FullName) ? email : u.FullName)</span>
                                    <span class="text-muted" style="font-size:12px;">@email</span>
                                    <span class="text-muted" style="font-size:12px;">Emp #@u.EmployeeNo</span>
                                    @if (already)
                                    {
                                        <span class="badge bg-secondary" style="margin-left:auto;">Added</span>
                                    }
                                </button>
                            }
                        }
                    </div>
                }
                <div class="form-text">Type to search, then click a person to add them. You can add several people before sharing.</div>
            </div>

            <div class="d-flex gap-2 mb-3">
                <input class="form-control" placeholder="Add an email manually..." value="@_shareEmailInput" @oninput="e => _shareEmailInput = e.Value?.ToString()" />
                <button type="button" class="btn btn-outline-secondary" @onclick="AddManualEmail">Add</button>
            </div>

            @if (_selectedShares.Any())
            {
                <div class="d-flex flex-wrap align-items-center" style="gap:6px;margin-bottom:12px;">
                    @foreach (var email in _selectedShares)
                    {
                        <span class="badge bg-secondary d-inline-flex align-items-center" style="padding:6px 10px;font-size:12.5px;">
                            @email
                            <button type="button" class="btn-close btn-close-white" style="font-size:8px;margin-left:6px;" aria-label="Remove" @onclick="() => RemoveShare(email)"></button>
                        </span>
                    }
                </div>
            }

            @if (!string.IsNullOrEmpty(_shareError))
            {
                <div class="alert alert-danger">@_shareError</div>
            }
            @if (!string.IsNullOrEmpty(_shareSuccess))
            {
                <div class="alert alert-success">@_shareSuccess</div>
            }

            <div class="d-flex justify-content-end" style="gap:10px;">
                <button type="button" class="btn btn-outline-secondary" @onclick="CloseShare">Cancel</button>
                <button type="button" class="btn btn-primary" disabled="@_busy" @onclick="SubmitShare">@(_busy ? "Sharing..." : "Share")</button>
            </div>
            <div class="form-text mt-2">Recipients get view-only access to this sheet and can leave suggestions.</div>
        </div>
    }

    <div class="content-card mb-4">
        <div class="section-title mb-3">Approval workflow</div>
        @if (!string.IsNullOrEmpty(_error))
        {
            <div class="alert alert-danger">@_error</div>
        }

        @{
            var maxStep = _sheet.ApprovalSteps.Count == 0 ? 0 : _sheet.ApprovalSteps.Max(s => s.StepIndex);
            var currentStep = ApprovalWorkflow.CurrentStep(_sheet.ApprovalSteps);
        }
        <div class="timeline">
            @foreach (var step in _sheet.ApprovalSteps.OrderBy(s => s.StepIndex))
            {
                var mineActionable = _myActionableSteps.Any(s => s.Id == step.Id);
                var isCurrent = currentStep is not null && currentStep.StepIndex == step.StepIndex;
                var isWaiting = step.Status != ApprovalStepStatus.Approved && !isCurrent;
                var canResolve = _isCreator && step.Status == ApprovalStepStatus.Reviewed && isCurrent;
                <div class="tl-step">
                    <div class="tl-rail">
                        <div class="tl-dot @DotClass(step.Status)">@step.StepIndex</div>
                        @if (step.StepIndex != maxStep)
                        {
                            <div class="tl-line"></div>
                        }
                    </div>
                    <div class="tl-body">
                        <div class="d-flex align-items-center gap-2 flex-wrap">
                            <span class="tl-approver">@step.ApproverEmail</span>
                            <span class="expected-chip">@(step.Action == ApprovalAction.Approve ? "Approve" : "Return")</span>
                            <span class="badge @StepStatusClass(step.Status)">@DisplayName(step.Status)</span>
                        </div>
                        <div style="font-size:12.5px;color:#9296ab;margin-top:4px;">
                            @if (step.ActedAt is not null)
                            {
                                @($"Acted {step.ActedAt.Value.ToLocalTime():dd MMM yyyy, HH:mm}")
                            }
                            else if (isWaiting)
                            {
                                @($"Waiting for step {currentStep!.StepIndex}")
                            }
                            else
                            {
                                @("Awaiting action")
                            }
                        </div>

                        @if (mineActionable)
                        {
                            <div class="action-zone mt-2" @key="@($"a{step.Id}-{_epoch}")">
                                <div class="fw-semibold mb-2">Your action</div>
                                <textarea class="form-control mb-2" rows="3" placeholder="Add a comment..."
                                          value="@GetDraft(step.Id)" @oninput="e => SetDraft(step.Id, e.Value?.ToString())"></textarea>
                                <div class="d-flex gap-2">
                                    <button class="btn btn-outline-primary" disabled="@_busy" @onclick="() => MarkReviewed(step.Id)">Return</button>
                                    <button class="btn btn-success" disabled="@_busy" @onclick="() => Approve(step.Id)">Approve</button>
                                    <button class="btn btn-outline-secondary" disabled="@_busy" @onclick="OpenShare">Share</button>
                                </div>
                                <div class="form-text">A return requires a comment; a comment is optional when approving.</div>
                            </div>
                        }

                        @if (canResolve)
                        {
                            <div class="action-zone action-zone--review mt-2" @key="@($"r{step.Id}-{_epoch}")">
                                <div class="fw-semibold mb-2">Resolve this review</div>
                                <textarea class="form-control mb-2" rows="3" placeholder="Describe how you resolved this review..."
                                          value="@GetResolveDraft(step.Id)" @oninput="e => SetResolveDraft(step.Id, e.Value?.ToString())"></textarea>
                                <button class="btn btn-primary" disabled="@_busy" @onclick="() => Resolve(step.Id)">Resolve &amp; send back</button>
                                <div class="form-text">Resolving sends this step back to Pending so the approver can review again or approve.</div>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    </div>

    <div class="content-card">
        <div class="section-title mb-3">Comments</div>
        @if (_sheet.Comments.Count == 0)
        {
            <p class="text-muted mb-0">No comments yet.</p>
        }
        else
        {
            <ul class="comment-thread">
                @foreach (var c in _sheet.Comments.OrderBy(c => c.CreatedAt))
                {
                    <li class="comment-item">
                        <div class="comment-avatar">@Initials(c.AuthorName, null)</div>
                        <div class="comment-bubble">
                            <div class="comment-head">
                                <span class="fw-semibold" style="font-size:13.5px;">@c.AuthorName</span>
                                <span class="badge @CommentKindClass(c.Kind)" style="font-size:11px;">@DisplayName(c.Kind)</span>
                                <span class="text-muted" style="font-size:12px;">@c.CreatedAt.ToLocalTime().ToString("dd MMM yyyy, HH:mm")</span>
                            </div>
                            <div class="comment-body">@c.Body</div>
                        </div>
                    </li>
                }
            </ul>
        }
    </div>

    <div class="content-card">
        <div class="section-title mb-3">Suggestions</div>
        @if (_suggestions.Count == 0)
        {
            <p class="text-muted mb-0">No suggestions yet.</p>
        }
        else
        {
            <ul class="comment-thread">
                @foreach (var s in _suggestions)
                {
                    <li class="comment-item">
                        <div class="comment-avatar">@Initials(s.AuthorName, null)</div>
                        <div class="comment-bubble">
                            <div class="comment-head">
                                <span class="fw-semibold" style="font-size:13.5px;">@s.AuthorName</span>
                                <span class="badge @(s.IsAllOk ? "bg-success" : "bg-info text-dark")" style="font-size:11px;">@(s.IsAllOk ? "All OK" : "Suggestion")</span>
                                <span class="text-muted" style="font-size:12px;">@s.CreatedAt.ToLocalTime().ToString("dd MMM yyyy, HH:mm")</span>
                            </div>
                            <div class="comment-body">@(s.IsAllOk ? "It's all OK — no changes needed." : s.Body)</div>
                        </div>
                    </li>
                }
            </ul>
        }

        @if (_isSharedWithMe)
        {
            <div class="action-zone mt-3">
                <div class="fw-semibold mb-2">Suggest something to add</div>
                <textarea class="form-control mb-2" rows="3" placeholder="What would you add or change in this minute sheet?"
                          value="@_suggestionDraft" @oninput="e => _suggestionDraft = e.Value?.ToString()"></textarea>
                <div class="d-flex gap-2">
                    <button class="btn btn-outline-primary" disabled="@_busy" @onclick="SubmitSuggestion">Send suggestion</button>
                    <button class="btn btn-success" disabled="@_busy" @onclick="SubmitAllOk">It's all OK</button>
                </div>
            </div>
        }
    </div>
}

@code {
    [Parameter] public Guid Token { get; set; }

    [CascadingParameter] private Task<AuthenticationState> AuthState { get; set; } = default!;

    private MinuteSheet? _sheet;
    private ApplicationUser? _me;
    private bool _loading = true;
    private bool _canView;
    private bool _isCreator;
    private bool _isApprover;
    private bool _isAdmin;
    private bool _canEdit;
    private bool _isSharedWithMe;
    private bool _isViewOnly;
    private string? _error;
    private bool _busy;

    private List<ApprovalStep> _myActionableSteps = new();
    private readonly Dictionary<int, string> _drafts = new();
    private readonly Dictionary<int, string> _resolveDrafts = new();

    private List<SheetSuggestion> _suggestions = new();
    private string _suggestionDraft = "";

    // Share dialog state.
    private bool _showSharePanel;
    private bool _showShareDropdown;
    private string _shareSearch = "";
    private string _shareEmailInput = "";
    private readonly HashSet<string> _selectedShares = new(StringComparer.OrdinalIgnoreCase);
    private List<ApplicationUser> _shareCandidates = new();
    private List<ApplicationUser> _shareFiltered = new();
    private string? _shareError;
    private string? _shareSuccess;

    private string _currentStatus = "Pending";
    private int _epoch;

    private DbContextOptions<ApplicationDbContext> _options = default!;

    protected override async Task OnInitializedAsync()
    {
        _options = new DbContextOptionsBuilder<ApplicationDbContext>()
            .UseSqlServer(Configuration.GetConnectionString("DefaultConnection"))
            .Options;

        var authState = await AuthState;
        _me = await UserManager.GetUserAsync(authState.User);
        _isAdmin = authState.User.IsInRole(Roles.Admin);
        await LoadAsync();
        _loading = false;
    }

    private ApplicationDbContext NewDb() => new(_options);

    private string GetDraft(int id) => _drafts.GetValueOrDefault(id, "");
    private void SetDraft(int id, string? v) => _drafts[id] = v ?? "";
    private string GetResolveDraft(int id) => _resolveDrafts.GetValueOrDefault(id, "");
    private void SetResolveDraft(int id, string? v) => _resolveDrafts[id] = v ?? "";

    private async Task LoadAsync()
    {
        await using var db = NewDb();
        _sheet = await db.MinuteSheets
            .AsNoTracking()
            .Include(m => m.ApprovalSteps)
            .Include(m => m.Comments)
            .Include(m => m.Department)
            .Include(m => m.CreatedByUser!).ThenInclude(u => u.Department)
            .FirstOrDefaultAsync(m => m.Token == Token);

        if (_sheet is null || _me is null)
        {
            return;
        }

        _isCreator = _sheet.CreatedByUserId == _me.Id;
        // Full edit while all steps are pending; limited edit (description +
        // attachment) once there are reviews to resolve. Admins can edit any sheet
        // on the same terms as its creator.
        _canEdit = (_isCreator || _isAdmin) && (_sheet.ApprovalSteps.All(s => s.Status == ApprovalStepStatus.Pending)
                                  || _sheet.ApprovalSteps.Any(s => s.Status == ApprovalStepStatus.Reviewed));
        var myEmail = _me.Email ?? "";
        var isApprover = _sheet.ApprovalSteps.Any(s => string.Equals(s.ApproverEmail, myEmail, StringComparison.OrdinalIgnoreCase));
        var isShared = await db.SheetShares.AnyAsync(s => s.MinuteSheetId == _sheet.Id
                                                          && s.SharedWithEmail == myEmail);
        _isApprover = isApprover;
        _isSharedWithMe = isShared;
        // Sharing only grants view access, so a shared viewer has no edit/approve/delete rights.
        _isViewOnly = isShared && !_isCreator && !isApprover && !_isAdmin;
        // Non-confidential sheets are visible to every user. Confidential sheets
        // are restricted to the creator, listed approvers, admins and anyone the
        // sheet was explicitly shared with.
        _canView = !_sheet.IsConfidential || _isCreator || isApprover || _isAdmin || isShared;

        _currentStatus = ApprovalWorkflow.StatusFor(_sheet);

        _suggestions = await db.SheetSuggestions
            .Where(s => s.MinuteSheetId == _sheet.Id)
            .OrderBy(s => s.CreatedAt)
            .ToListAsync();

        _shareCandidates = await db.Users
            .Where(u => u.Email != null)
            .OrderBy(u => u.Email)
            .ToListAsync();

        // Hierarchical workflow: only the current step's approver can act, and only
        // once every earlier step has been approved.
        var current = ApprovalWorkflow.CurrentStep(_sheet.ApprovalSteps);
        _myActionableSteps = current is not null
            && string.Equals(current.ApproverEmail, myEmail, StringComparison.OrdinalIgnoreCase)
                ? new List<ApprovalStep> { current }
                : new List<ApprovalStep>();

        // Bump the epoch so action zones are re-keyed and their textareas reset.
        _epoch++;
    }

    private string MyName() =>
        _me is null ? "" : (string.IsNullOrWhiteSpace(_me.FullName) ? _me.Email ?? "" : _me.FullName);

    private void OpenShare()
    {
        _shareError = null;
        _shareSuccess = null;
        _showSharePanel = true;
    }

    private void CloseShare()
    {
        _showSharePanel = false;
        _shareError = null;
        _shareSuccess = null;
    }

    private void OnShareSearch(ChangeEventArgs e)
    {
        _shareSearch = e.Value?.ToString() ?? "";
        FilterShareUsers();
        _showShareDropdown = true;
    }

    private void FilterShareUsers()
    {
        var q = _shareSearch.Trim();
        IEnumerable<ApplicationUser> query = _shareCandidates;
        if (!string.IsNullOrEmpty(q))
        {
            query = query.Where(u =>
                (u.FullName != null && u.FullName.Contains(q, StringComparison.OrdinalIgnoreCase))
                || (u.Email != null && u.Email.Contains(q, StringComparison.OrdinalIgnoreCase))
                || (u.EmployeeNo != null && u.EmployeeNo.Contains(q, StringComparison.OrdinalIgnoreCase)));
        }
        _shareFiltered = query.Take(10).ToList();
    }

    private void AddShareUser(string email)
    {
        _selectedShares.Add(email);
        _shareSearch = "";
        _shareFiltered = new();
        _showShareDropdown = false;
        _shareError = null;
    }

    private async Task HideShareDropdown()
    {
        // Wait briefly so the item's @onmousedown (which uses @mousedown, fired
        // before blur) has already run before we hide the list.
        await Task.Delay(150);
        _showShareDropdown = false;
    }

    private void RemoveShare(string email) => _selectedShares.Remove(email);

    private void AddManualEmail()
    {
        var parts = _shareEmailInput.Split(new[] { ',', ';', '\n' }, StringSplitOptions.RemoveEmptyEntries);
        foreach (var part in parts)
        {
            var email = part.Trim();
            if (email.Contains('@'))
            {
                _selectedShares.Add(email);
            }
            else if (!string.IsNullOrEmpty(email))
            {
                _shareError = "Please enter valid email addresses.";
            }
        }
        _shareEmailInput = "";
    }

    private async Task SubmitShare()
    {
        if (_me is null || _sheet is null)
        {
            return;
        }

        if (_selectedShares.Count == 0)
        {
            _shareError = "Select at least one person to share with.";
            return;
        }

        _busy = true;
        _shareError = null;
        _shareSuccess = null;

        try
        {
            var myEmail = _me.Email ?? "";
            var added = new List<string>();
            await using (var db = NewDb())
            {
                var existing = await db.SheetShares
                    .Where(s => s.MinuteSheetId == _sheet.Id)
                    .Select(s => s.SharedWithEmail)
                    .ToListAsync();
                var existingSet = new HashSet<string>(existing, StringComparer.OrdinalIgnoreCase);

                foreach (var email in _selectedShares)
                {
                    if (string.Equals(email, myEmail, StringComparison.OrdinalIgnoreCase))
                    {
                        continue;
                    }
                    if (existingSet.Contains(email))
                    {
                        continue;
                    }

                    db.SheetShares.Add(new SheetShare
                    {
                        MinuteSheetId = _sheet.Id,
                        SharedByUserId = _me.Id,
                        SharedWithEmail = email
                    });
                    existingSet.Add(email);
                    added.Add(email);
                }

                await db.SaveChangesAsync();
            }

            // Build a PDF copy of the sheet (once) so recipients can view it from
            // the email even without opening a link.
            byte[]? pdfBytes = null;
            if (added.Count > 0)
            {
                var creatorName = string.IsNullOrWhiteSpace(_sheet.CreatedByUser?.FullName)
                    ? _sheet.CreatedByUser?.Email ?? ""
                    : _sheet.CreatedByUser!.FullName;
                pdfBytes = PdfService.Build(_sheet, creatorName);
            }

            foreach (var email in added)
            {
                EmailQueue.Enqueue(new EmailJob(
                    email,
                    "A minute sheet was shared with you",
                    $"{MyName()} shared a minute sheet with you. A PDF copy is attached to this email and you can also open it from the link below.",
                    NavigationManager.ToAbsoluteUri($"dashboard/sheet/{Token}").AbsoluteUri,
                    pdfBytes,
                    $"minute-sheet-{Token:N}.pdf"));
            }

            _shareSuccess = added.Count > 0
                ? $"Shared view access with: {string.Join(", ", added)}"
                : "Those people already have view access to this sheet.";
            _selectedShares.Clear();
            _shareEmailInput = "";
            _shareSearch = "";
            _shareFiltered = new();
            _showShareDropdown = false;

            await LoadAsync();
        }
        catch (Exception ex)
        {
            _shareError = $"Something went wrong: {ex.Message}";
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task SubmitSuggestion()
    {
        if (_me is null || _sheet is null)
        {
            return;
        }

        var body = _suggestionDraft.Trim();
        if (body.Length == 0)
        {
            _error = "Please write what you'd like to add or change.";
            return;
        }

        _busy = true;
        _error = null;
        await using (var db = NewDb())
        {
            db.SheetSuggestions.Add(new SheetSuggestion
            {
                MinuteSheetId = _sheet.Id,
                AuthorUserId = _me.Id,
                AuthorName = MyName(),
                IsAllOk = false,
                Body = body
            });
            await db.SaveChangesAsync();
        }

        _suggestionDraft = "";
        await LoadAsync();
        _busy = false;
    }

