    private async Task MarkReviewed(int stepId)
    {
        if (_me is null) return;
        var comment = GetDraft(stepId).Trim();
        if (comment.Length == 0)
        {
            ToastService.ShowError("Please add a comment explaining your review.", "Comment required");
            return;
        }

        _busy = true;
        _error = null;

        string? creatorEmail;
        await using (var db = NewDb())
        {
            var sheet = await db.MinuteSheets.Include(m => m.ApprovalSteps).Include(m => m.CreatedByUser)
                .FirstOrDefaultAsync(m => m.Token == Token);
            var step = sheet?.ApprovalSteps.FirstOrDefault(s => s.Id == stepId);
            if (sheet is null || step is null) { _busy = false; return; }
            if (!ApprovalWorkflow.IsActionable(step, sheet.ApprovalSteps))
            {
                ToastService.ShowError("An earlier approval step is still open, so this step can't be actioned yet.", "Step not ready");
                _busy = false;
                return;
            }

            step.Status = ApprovalStepStatus.Reviewed;
            step.ActedAt = DateTime.UtcNow;
            db.Comments.Add(new SheetComment
            {
                MinuteSheetId = sheet.Id,
                ApprovalStepId = step.Id,
                AuthorUserId = _me.Id,
                AuthorName = MyName(),
                Kind = CommentKind.Review,
                Body = comment
            });
            sheet.Status = ApprovalWorkflow.StatusFor(sheet);
            await db.SaveChangesAsync();
            creatorEmail = sheet.CreatedByUser?.Email;
        }

        _drafts.Remove(stepId);
        await LoadAsync();

        if (!string.IsNullOrEmpty(creatorEmail))
        {
            EmailQueue.Enqueue(new EmailJob(
                creatorEmail,
                "A review was left on your minute sheet",
                $"{MyName()} reviewed your minute sheet and left a comment to resolve.",
                NavigationManager.Uri));
        }
        ToastService.ShowSuccess("Your review has been submitted and the sheet creator was notified.", "Review submitted");
        _busy = false;
    }

    private async Task Approve(int stepId)
    {
        if (_me is null) return;

        _busy = true;
        _error = null;
        var comment = GetDraft(stepId).Trim();

        bool fullyApproved;
        string? creatorEmail;
        await using (var db = NewDb())
        {
            var sheet = await db.MinuteSheets.Include(m => m.ApprovalSteps).Include(m => m.CreatedByUser)
                .FirstOrDefaultAsync(m => m.Token == Token);
            var step = sheet?.ApprovalSteps.FirstOrDefault(s => s.Id == stepId);
            if (sheet is null || step is null) { _busy = false; return; }
            if (!ApprovalWorkflow.IsActionable(step, sheet.ApprovalSteps))
            {
                ToastService.ShowError("An earlier approval step is still open, so this step can't be actioned yet.", "Step not ready");
                _busy = false;
                return;
            }

            step.Status = ApprovalStepStatus.Approved;
            step.ActedAt = DateTime.UtcNow;
            if (comment.Length > 0)
            {
                db.Comments.Add(new SheetComment
                {
                    MinuteSheetId = sheet.Id,
                    ApprovalStepId = step.Id,
                    AuthorUserId = _me.Id,
                    AuthorName = MyName(),
                    Kind = CommentKind.Approval,
                    Body = comment
                });
            }
            sheet.Status = ApprovalWorkflow.StatusFor(sheet);
            await db.SaveChangesAsync();
            fullyApproved = sheet.Status == "Approved";
            creatorEmail = sheet.CreatedByUser?.Email;
        }

        _drafts.Remove(stepId);
        await LoadAsync();

        if (fullyApproved && !string.IsNullOrEmpty(creatorEmail))
        {
            EmailQueue.Enqueue(new EmailJob(
                creatorEmail,
                "Your minute sheet is fully approved",
                "All approvers have approved your minute sheet.",
                NavigationManager.Uri));
        }
        ToastService.ShowSuccess(fullyApproved
            ? "All approval steps are complete and the sheet is fully approved."
            : "This step has been approved. The next approver has been notified.", fullyApproved ? "Fully approved" : "Step approved");
        _busy = false;
    }

    private async Task Resolve(int stepId)
    {
        if (_me is null || !_isCreator) return;

        var note = GetResolveDraft(stepId).Trim();
        if (note.Length == 0)
        {
            ToastService.ShowError("Please describe how you resolved the review.", "Note required");
            return;
        }

        _busy = true;
        _error = null;

        string? approverEmail;
        await using (var db = NewDb())
        {
            var sheet = await db.MinuteSheets.Include(m => m.ApprovalSteps)
                .FirstOrDefaultAsync(m => m.Token == Token);
            var step = sheet?.ApprovalSteps.FirstOrDefault(s => s.Id == stepId);
            if (sheet is null || step is null) { _busy = false; return; }

            db.Comments.Add(new SheetComment
            {
                MinuteSheetId = sheet.Id,
                ApprovalStepId = step.Id,
                AuthorUserId = _me.Id,
                AuthorName = MyName(),
                Kind = CommentKind.Resolution,
                Body = note
            });
            // Send the step back so the approver looks again.
            step.Status = ApprovalStepStatus.Pending;
            step.ActedAt = null;
            approverEmail = step.ApproverEmail;
            sheet.Status = ApprovalWorkflow.StatusFor(sheet);
            await db.SaveChangesAsync();
        }

        _resolveDrafts.Remove(stepId);
        await LoadAsync();

        if (!string.IsNullOrEmpty(approverEmail))
        {
            EmailQueue.Enqueue(new EmailJob(
                approverEmail,
                "Your review was resolved",
                $"{MyName()} resolved your review. Please take another look and review or approve.",
                NavigationManager.Uri));
        }
        ToastService.ShowSuccess("The review has been resolved and sent back to the approver.", "Review resolved");
        _busy = false;
    }

    private async Task DeleteSheet()
    {
        if (_sheet is null || !_isCreator) return;

        var confirmed = await JS.InvokeAsync<bool>("confirm",
            "Delete this minute sheet? This permanently removes it along with its approval steps and comments. This cannot be undone.");
        if (!confirmed) return;

        _busy = true;
        _error = null;

        string? attachmentPath;
        await using (var db = NewDb())
        {
            var sheet = await db.MinuteSheets.FirstOrDefaultAsync(m => m.Token == Token);
            if (sheet is null || sheet.CreatedByUserId != _me!.Id) { _busy = false; return; }

            attachmentPath = sheet.AttachmentStoredPath;
            db.MinuteSheets.Remove(sheet);
            await db.SaveChangesAsync();
        }

        if (!string.IsNullOrEmpty(attachmentPath))
        {
            try
            {
                var fullPath = Path.Combine(Env.WebRootPath, attachmentPath);
                if (File.Exists(fullPath)) File.Delete(fullPath);
            }
            catch (IOException) { /* best-effort cleanup */ }
        }

        ToastService.ShowSuccess("The minute sheet was deleted permanently.", "Sheet deleted");
        NavigationManager.NavigateTo("/dashboard/history", forceLoad: false);
    }

    private string CreatorMeta()
    {
        var u = _sheet?.CreatedByUser;
        if (u is null) return "";
        var parts = new List<string> { DesignationName(u.Designation) };
        if (!string.IsNullOrEmpty(u.Department?.Name)) parts.Add(u.Department!.Name);
        if (!string.IsNullOrEmpty(u.EmployeeNo)) parts.Add($"Emp #{u.EmployeeNo}");
        return string.Join(" · ", parts);
    }

    private static (List<string> Actions, List<string> Decisions) ParseActionsDecisions(string? json)
    {
        var actions = new List<string>();
        var decisions = new List<string>();
        if (string.IsNullOrWhiteSpace(json))
        {
            return (actions, decisions);
        }
        try
        {
            using var doc = System.Text.Json.JsonDocument.Parse(json);
            var root = doc.RootElement;
            if (root.TryGetProperty("actions", out var a) && a.ValueKind == System.Text.Json.JsonValueKind.Array)
            {
                foreach (var item in a.EnumerateArray())
                {
                    var text = item.GetString()?.Trim();
                    if (!string.IsNullOrWhiteSpace(text)) actions.Add(text);
                }
            }
            if (root.TryGetProperty("decisions", out var d) && d.ValueKind == System.Text.Json.JsonValueKind.Array)
            {
                foreach (var item in d.EnumerateArray())
                {
                    var text = item.GetString()?.Trim();
                    if (!string.IsNullOrWhiteSpace(text)) decisions.Add(text);
                }
            }
        }
        catch
        {
            // Ignore malformed JSON.
        }
        return (actions, decisions);
    }

    private static string DotClass(ApprovalStepStatus s) => s switch
    {
        ApprovalStepStatus.Approved => "is-approved",
        ApprovalStepStatus.Reviewed => "is-reviewed",
        _ => ""
    };

    private static string DisplayName(ApprovalStepStatus s) => s switch
    {
        ApprovalStepStatus.Reviewed => "Reviewed",
        ApprovalStepStatus.Approved => "Approved",
        _ => "Pending"
    };

    private static string DisplayName(CommentKind k) => k switch
    {
        CommentKind.Review => "Review",
        CommentKind.Approval => "Approval",
        CommentKind.Resolution => "Resolution",
        _ => k.ToString()
    };

    private static string SheetStatusClass(string status) =>
        status == "Approved" ? "bg-success" : "bg-warning text-dark";

    private static string StepStatusClass(ApprovalStepStatus s) => s switch
    {
        ApprovalStepStatus.Approved => "bg-success",
        ApprovalStepStatus.Reviewed => "bg-warning text-dark",
        _ => "bg-secondary"
    };

    private static string CommentKindClass(CommentKind k) => k switch
    {
        CommentKind.Approval => "bg-success",
        CommentKind.Resolution => "bg-info text-dark",
        _ => "bg-warning text-dark"
    };

    private static string DesignationName(Designation d)
    {
        var member = typeof(Designation).GetMember(d.ToString()).FirstOrDefault();
        var attr = member?.GetCustomAttributes(typeof(DisplayAttribute), false).FirstOrDefault() as DisplayAttribute;
        return attr?.Name ?? d.ToString();
    }

    private static string Initials(string? fullName, string? email)
    {
        var source = !string.IsNullOrWhiteSpace(fullName) ? fullName : email ?? "";
        var parts = source.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 0)
        {
            return "?";
        }
        if (parts.Length == 1)
        {
            var word = parts[0];
            return (word.Length >= 2 ? word[..2] : word).ToUpperInvariant();
        }
        return (parts[0][..1] + parts[^1][..1]).ToUpperInvariant();
    }
