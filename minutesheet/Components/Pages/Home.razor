@page "/"
@rendermode InteractiveServer

@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using System.Globalization
@using System.Text
@using minutesheet.Data

@attribute [Authorize]

<HeadContent>
    <link rel="stylesheet" href="home.css" />
</HeadContent>

<PageTitle>Dashboard</PageTitle>

@{
    var maxMonth = _monthly.Count == 0 ? 0 : _monthly.Max(m => m.Count);
    var done = _approved;
    var inProgress = Math.Max(0, _total - _approved);
    var pendingCount = _pendingApproval;
    string F(double v) => v.ToString("0.##", CultureInfo.InvariantCulture);

    var progressDenom = Math.Max(1, done + _reviewsToResolve + pendingCount);
    var approvedPct = done * 100.0 / progressDenom;
    var reviewPct = _reviewsToResolve * 100.0 / progressDenom;
    var pendingPct = pendingCount * 100.0 / progressDenom;
    var alerts = _pendingApproval + _reviewsToResolve;

    // Trend card data (approved count per month)
    var trendCounts = _monthlyApproved.Select(x => (double)x.Count).ToArray();
    var trendPts = TrendPoints(trendCounts, 300, 120);
    var trendLine = SmoothPath(trendCounts, 300, 120);
    var trendFill = SmoothAreaFill(trendCounts, 300, 120);
    var approvedThisMonth = _monthlyApproved.Count > 0 ? _monthlyApproved[^1].Count : 0;
    var approvedLastMonth = _monthlyApproved.Count > 1 ? _monthlyApproved[^2].Count : 0;
    var trendPct = approvedLastMonth == 0
        ? (approvedThisMonth > 0 ? 100.0 : 0.0)
        : (approvedThisMonth - approvedLastMonth) * 100.0 / approvedLastMonth;
}

<div class="dash-wrap">

    <div class="topbar">
        <div class="topbar-left">
            <div class="topbar-title">Dashboard</div>
            <div class="topbar-date">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2"></rect><path d="M16 2v4M8 2v4M3 10h18"></path></svg>
                @DateTime.Now.ToString("dd MMM yyyy")
            </div>
        </div>

        <div class="topbar-right">
            @* Hidden header quick-action buttons (Create New Sheet / History / Actions).
               They are still available in the sidebar NavMenu, so this just removes
               them from the dashboard top bar. To restore, delete this comment block. *@
            @*<div class="hdr-actions">
                <a class="btn-hdr btn-hdr-primary" href="dashboard/create">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 5v14M5 12h14"></path></svg>
                    Create New Sheet
                </a>
                <a class="btn-hdr" href="dashboard/history">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"></circle><path d="M12 7v5l3.5 2"></path></svg>
                    History
                </a>
                <a class="btn-hdr" href="dashboard/actions">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 12l2 2 4-4"></path><circle cx="12" cy="12" r="9"></circle></svg>
                    Actions
                </a>
            </div>*@

            <!-- Theme toggle (sun / moon) -->
            <button type="button" class="icon-btn" @onclick="ToggleTheme" title="Toggle theme">
                @if (_isDark)
                {
                    <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path></svg>
                }
                else
                {
                    <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path></svg>
                }
            </button>

            <!-- Notifications bell + dropdown panel -->
            <div class="notif-wrap">
                <button type="button" class="icon-btn" title="Notifications" @onclick="ToggleNotifications">
                    <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 8a6 6 0 0 1 12 0c0 5 2 6 2 6H4s2-1 2-6"></path><path d="M10 20a2 2 0 0 0 4 0"></path></svg>
                    @if (alerts > 0)
                    {
                        <span class="dot-badge">@alerts</span>
                    }
                </button>

                @if (_showNotifications)
                {
                    <div class="notif-panel">
                        <div class="notif-head">Notifications</div>
                        @if (_pendingSteps.Count == 0 && _returnedSheets.Count == 0)
                        {
                            <div class="notif-empty">You're all caught up.</div>
                        }
                        else
                        {
                            @foreach (var sheet in _returnedSheets)
                            {
                                <div class="notif-item" @onclick="() => GoToReturnedSheet(sheet.Token)">
                                    <div class="notif-title">Your sheet was returned for revision</div>
                                    <div class="notif-sub">@(sheet.Category == SheetCategory.NonFinancial ? "Non-Financial" : "Financial") sheet · @sheet.CreatedAt.ToLocalTime().ToString("dd MMM")</div>
                                </div>
                            }
                            @foreach (var step in _pendingSteps)
                            {
                                var isReview = step.Status == ApprovalStepStatus.Reviewed;
                                <div class="notif-item" @onclick="() => GoToSheet(step)">
                                    <div class="notif-title">@(isReview ? "Review sent back to you" : "Awaiting your approval")</div>
                                    <div class="notif-sub">@(step.MinuteSheet.Category == SheetCategory.NonFinancial ? "Non-Financial" : "Financial") sheet · @step.MinuteSheet.CreatedAt.ToLocalTime().ToString("dd MMM")</div>
                                </div>
                            }
                        }
                    </div>
                }
            </div>

            <!-- Signed-in user chip (avatar + name + role) -->
            <div class="user-chip">
                <div class="avatar">
                    @if (!string.IsNullOrEmpty(_avatarPath))
                    {
                        <img src="/@_avatarPath" alt="Profile" style="width:100%;height:100%;border-radius:50%;object-fit:cover;" />
                    }
                    else
                    {
                        @(_firstName.Length > 0 ? _firstName.Substring(0, 1).ToUpper() : "U")
                    }
                </div>
                <div>
                    <div class="user-name">@_firstName</div>
                    <div class="user-role">Member</div>
                </div>
            </div>
        </div>
    </div>

    <div class="dash-header">
        <div>
            <div class="dash-greeting-title">@Greeting, @_firstName</div>
            <div class="dash-greeting-sub">@DateTime.Now.ToString("dddd, dd MMMM") · here's what's happening with your minute sheets.</div>
        </div>
    </div>

    <div class="stat-grid">
        <div class="stat-card">
            <div class="stat-top">
                <div class="stat-label">Pending your approval</div>
                <div class="stat-icon stat-icon-amber">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"></circle><path d="M12 7v5l3.2 2"></path></svg>
                </div>
            </div>
            <div class="stat-value">@_pendingApproval</div>
            <div class="stat-bottom">
                <div class="stat-sub">awaiting your action</div>
                <div class="spark">
                    @foreach (var m in _monthly)
                    {
                        var h = maxMonth == 0 ? 8 : Math.Max(4, (int)Math.Round(m.Count * 30.0 / maxMonth));
                        <i class="@(m.Count > 0 ? "on-amber" : "")" style="height:@(h)px"></i>
                    }
                </div>
            </div>
        </div>

        <div class="stat-card">
            <div class="stat-top">
                <div class="stat-label">Reviews to resolve</div>
                <div class="stat-icon stat-icon-blue">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a9 9 0 1 1-2.6-6.36"></path><path d="M21 4v5h-5"></path></svg>
                </div>
            </div>
            <div class="stat-value">@_reviewsToResolve</div>
            <div class="stat-bottom">
                <div class="stat-sub">sent back to you</div>
                <div class="spark">
                    @foreach (var m in _monthly)
                    {
                        var h = maxMonth == 0 ? 8 : Math.Max(4, (int)Math.Round(m.Count * 30.0 / maxMonth));
                        <i class="@(m.Count > 0 ? "on-blue" : "")" style="height:@(h)px"></i>
                    }
                </div>
            </div>
        </div>

        <div class="stat-card">
            <div class="stat-top">
                <div class="stat-label">Approved</div>
                <div class="stat-icon stat-icon-green">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"></circle><path d="M8.5 12.5l2.3 2.3L16 9.7"></path></svg>
                </div>
            </div>
            <div class="stat-value">@_approved</div>
            <div class="stat-bottom">
                <div class="stat-sub">of your sheets</div>
                <div class="spark">
                    @foreach (var m in _monthly)
                    {
                        var h = maxMonth == 0 ? 8 : Math.Max(4, (int)Math.Round(m.Count * 30.0 / maxMonth));
                        <i class="@(m.Count > 0 ? "on-green" : "")" style="height:@(h)px"></i>
                    }
                </div>
            </div>
        </div>

        <div class="stat-card">
            <div class="stat-top">
                <div class="stat-label">Total sheets</div>
                <div class="stat-icon stat-icon-navy">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"></path><path d="M14 3v5h5"></path><path d="M9 13h6M9 17h6"></path></svg>
                </div>
            </div>
            <div class="stat-value">@_total</div>
            <div class="stat-bottom">
                <div class="stat-sub">you've created</div>
                <div class="spark">
                    @foreach (var m in _monthly)
                    {
                        var h = maxMonth == 0 ? 8 : Math.Max(4, (int)Math.Round(m.Count * 30.0 / maxMonth));
                        <i class="@(m.Count > 0 ? "on-navy" : "")" style="height:@(h)px"></i>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="section-title">Overview</div>
    <div class="chart-grid">

        <div class="chart-card">
            <div class="chart-head"><h3>Sheets Overview</h3></div>
            <div class="chart-legend-top">
                <span><i style="background:#a5abf0"></i>Total sheets</span>
                <span><i style="background:#4f46e5"></i>Approved · @(_total > 0 ? $"{(int)Math.Round(_approved * 100.0 / _total)}%" : "0%")</span>
            </div>
            @{
                var currentMonthLabel = DateTime.Now.ToString("MMM");
            }
            <div class="bar-pct-row">
                @foreach (var m in _monthly)
                {
                    var share = m.Count == 0 ? 0 : (int)Math.Round(_monthlyApproved.FirstOrDefault(x => x.Label == m.Label).Count * 100.0 / m.Count);
                    <div class="bar-pct-cell @(m.Label == currentMonthLabel ? "current" : "")">@share%</div>
                }
            </div>
            <div class="bar-chart">
                <div class="scan-line"></div>
                @foreach (var m in _monthly)
                {
                    var totalH = maxMonth == 0 ? 0 : (int)Math.Round(m.Count * 100.0 / maxMonth);
                    var approvedForMonth = _monthlyApproved.FirstOrDefault(x => x.Label == m.Label).Count;
                    var approvedH = maxMonth == 0 ? 0 : (int)Math.Round(approvedForMonth * 100.0 / maxMonth);
                    <div class="bar-col">
                        <div class="bar-track">
                            <div class="bar-seg total"><div class="bar-fill-total" style="height:@(totalH)%"></div></div>
                            <div class="bar-seg"><div class="bar-fill-approved" style="height:@(approvedH)%"></div></div>
                        </div>
                        <div class="bar-lbl @(m.Label == currentMonthLabel ? "current" : "")">@m.Label</div>
                    </div>
                }
            </div>
        </div>

        <div class="chart-card trend-card">
            <div class="trend-head">
                <div>
                    <div class="trend-title">Sheets Approved</div>
                    <div class="trend-sub">All-time approved minute sheets</div>
                </div>
                <span class="trend-badge @(trendPct >= 0 ? "up" : "down")">
                    @(trendPct >= 0 ? "↑" : "↓") @F(Math.Abs(trendPct))%
                </span>
            </div>
            <div class="trend-num">@_approved</div>
            <div class="trend-chart">
                <svg viewBox="0 0 300 120">
                    <defs>
                        <linearGradient id="trendFillGrad" x1="0" y1="0" x2="0" y2="1">
                            <stop offset="0%" stop-color="#4f46e5" stop-opacity="0.35"></stop>
                            <stop offset="100%" stop-color="#4f46e5" stop-opacity="0.02"></stop>
                        </linearGradient>
                    </defs>
                    <path d="@trendFill" fill="url(#trendFillGrad)" stroke="none"></path>
                    <path d="@trendLine" fill="none" stroke="#4f46e5" stroke-width="2.5" stroke-linecap="round"></path>
                    @for (var i = 0; i < trendPts.Count; i++)
                    {
                        <circle cx="@F(trendPts[i].X)" cy="@F(trendPts[i].Y)" r="3.5" fill="#fff" stroke="#4f46e5" stroke-width="2"></circle>
                    }
                </svg>
            </div>
            <div class="trend-labels">
                @foreach (var m in _monthlyApproved)
                {
                    <span>@m.Label</span>
                }
            </div>
        </div>
    </div>

    <div class="section-title">
        <span>My upcoming actions</span>
        <a class="section-link" href="dashboard/actions">View all</a>
    </div>
    <div class="chart-card" style="padding:6px 22px;">
        @if (_pendingSteps.Count == 0 && _returnedSheets.Count == 0)
        {
            <div class="empty-cell">Nothing waiting on you right now.</div>
        }
        else
        {
            @foreach (var sheet in _returnedSheets.Take(2))
            {
                <div class="ua-row" @onclick="() => GoToReturnedSheet(sheet.Token)">
                    <span class="ua-dot" style="background:#e55353"></span>
                    <div class="ua-main">
                        <div class="ua-title">@sheet.Title</div>
                        <div class="ua-sub">Returned for revision · @(sheet.Category == SheetCategory.NonFinancial ? "Non-Financial" : "Financial") · @sheet.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")</div>
                    </div>
                    <span class="badge bg-danger">Returned</span>
                </div>
            }
            @foreach (var step in _pendingSteps.Take(4))
            {
                var isReview = step.Status == ApprovalStepStatus.Reviewed;
                <div class="ua-row" @onclick="() => GoToSheet(step)">
                    <span class="ua-dot" style="background:@(isReview ? "#3548d4" : "#e2a138")"></span>
                    <div class="ua-main">
                        <div class="ua-title">@step.MinuteSheet.Title</div>
                        <div class="ua-sub">@(isReview ? "Review" : "Approve") · @(step.MinuteSheet.Category == SheetCategory.NonFinancial ? "Non-Financial" : "Financial") · @step.MinuteSheet.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")</div>
                    </div>
                    <span class="badge bg-warning">@(isReview ? "Needs review" : "Pending")</span>
                </div>
            }
        }
    </div>

    <div class="section-title">
        <span>Recent sheets</span>
        <a class="section-link" href="dashboard/history">View all</a>
    </div>
    <div class="chart-card table-card">
        <table class="sheets-table">
            <thead>
                <tr>
                    <th>Ref</th>
                    <th>Category</th>
                    <th>Date</th>
                    <th>Progress</th>
                    <th>Approvals</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                @if (_recent.Count == 0)
                {
                    <tr><td colspan="6" class="empty-cell">No minute sheets yet. Create your first one.</td></tr>
                }
                else
                {
                    @for (var i = 0; i < _recent.Count; i++)
                    {
                        var sheet = _recent[i];
                        var status = ApprovalWorkflow.StatusFor(sheet);
                        var approvedSteps = ApprovalWorkflow.ApprovedCount(sheet.ApprovalSteps);
                        var badgeClass = status switch
                        {
                            "Approved" => "bg-success",
                            "Review" => "bg-info",
                            _ => "bg-warning"
                        };
                        <tr class="clickable" @onclick='() => Nav.NavigateTo($"dashboard/sheet/{sheet.Token}")'>
                            <td class="sheet-ref">#@((i + 1).ToString("D3"))</td>
                            <td class="sheet-cat">@(sheet.Category == SheetCategory.NonFinancial ? "Non-Financial" : "Financial")</td>
                            <td>@sheet.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")</td>
                            <td>@approvedSteps / @sheet.ApprovalSteps.Count approved</td>
                            <td>
                                @{
                                    var by = sheet.ApprovalSteps
                                        .Where(s => s.Status == ApprovalStepStatus.Approved || s.Status == ApprovalStepStatus.Reviewed)
                                        .ToList();
                                }
                                @if (by.Count == 0)
                                {
                                    <span style="color:var(--text-muted);font-size:12px;">—</span>
                                }
                                else
                                {
                                    <div class="by-stack">
                                        @foreach (var s in by)
                                        {
                                            var byName = _approverNames.TryGetValue(s.ApproverEmail, out var n) ? n : s.ApproverEmail;
                                            <div class="by-chip">
                                                <span class="by-avatar" style="background:@AvatarColor(byName)">@AvatarInitials(byName)</span>
                                                <span class="by-name">@byName</span>
                                            </div>
                                        }
                                    </div>
                                }
                            </td>
                            <td><span class="badge @badgeClass">@status</span></td>
                        </tr>
                    }
                }
                </tbody>
            </table>
    </div>

</div>

