@page "/"
@rendermode InteractiveServer

@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using System.Globalization
@using minutesheet.Data

@attribute [Authorize]

@inject ApplicationDbContext DbContext
@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>Dashboard</PageTitle>

<div style="margin-bottom:30px;">
    <div class="dash-greeting-title">@Greeting, @_firstName</div>
    <div class="dash-greeting-sub">@DateTime.Now.ToString("dddd, dd MMMM") · here's what's happening with your minute sheets.</div>
</div>

<div class="stat-grid">
    <div class="stat-card">
        <div class="stat-label">Pending your approval</div>
        <div class="stat-value" style="color:#b26a00;">@_pendingApproval</div>
        <div class="stat-sub">awaiting your action</div>
    </div>
    <div class="stat-card">
        <div class="stat-label">Reviews to resolve</div>
        <div class="stat-value" style="color:#3548d4;">@_reviewsToResolve</div>
        <div class="stat-sub">sent back to you</div>
    </div>
    <div class="stat-card">
        <div class="stat-label">Approved</div>
        <div class="stat-value" style="color:#17875a;">@_approved</div>
        <div class="stat-sub">of your sheets</div>
    </div>
    <div class="stat-card">
        <div class="stat-label">Total sheets</div>
        <div class="stat-value" style="color:#14173a;">@_total</div>
        <div class="stat-sub">you've created</div>
    </div>
</div>

<div class="section-title">Overview</div>
<div class="chart-grid">
    <div class="chart-card">
        <div class="chart-head">Approval status</div>
        @{
            var done = _approved;
            var inProgress = Math.Max(0, _total - _approved);
            var donutTotal = done + inProgress;
            const double r = 52;
            var circ = 2 * Math.PI * r;
            var approvedLen = donutTotal == 0 ? 0 : circ * done / donutTotal;
            string F(double v) => v.ToString("0.##", CultureInfo.InvariantCulture);
        }
        <div class="donut-wrap">
            <svg viewBox="0 0 140 140" width="150" height="150">
                <circle cx="70" cy="70" r="52" fill="none" stroke="#eef0f6" stroke-width="16"></circle>
                @if (donutTotal > 0)
                {
                    <circle cx="70" cy="70" r="52" fill="none" stroke="#e2a138" stroke-width="16"></circle>
                    <circle cx="70" cy="70" r="52" fill="none" stroke="#17875a" stroke-width="16"
                            stroke-dasharray="@F(approvedLen) @F(circ - approvedLen)"
                            stroke-linecap="round" transform="rotate(-90 70 70)"></circle>
                }
                <text x="70" y="66" text-anchor="middle" class="donut-num">@_total</text>
                <text x="70" y="86" text-anchor="middle" class="donut-cap">total sheets</text>
            </svg>
        </div>
        <div class="chart-legend">
            <span class="lg"><i style="background:#17875a"></i>Approved @done</span>
            <span class="lg"><i style="background:#e2a138"></i>In progress @inProgress</span>
        </div>
    </div>

    <div class="chart-card">
        <div class="chart-head">Activity · last 6 months</div>
        @{
            var maxMonth = _monthly.Count == 0 ? 0 : _monthly.Max(m => m.Count);
        }
        <div class="bar-chart">
            @foreach (var m in _monthly)
            {
                var h = maxMonth == 0 ? 0 : (int)Math.Round(m.Count * 100.0 / maxMonth);
                <div class="bar-col">
                    <div class="bar-val">@(m.Count > 0 ? m.Count.ToString() : "")</div>
                    <div class="bar-track"><div class="bar-fill" style="height:@(h)%"></div></div>
                    <div class="bar-lbl">@m.Label</div>
                </div>
            }
        </div>
    </div>
</div>

<div class="section-title">Quick actions</div>
<div class="qa-grid">
    <a class="qa-card qa-dark" href="dashboard/create">
        <div class="qa-icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2"><path d="M12 5v14M5 12h14"></path></svg></div>
        <div class="qa-title">Create a new sheet</div>
        <div class="qa-desc">Start a minute sheet with description, attachment and approval workflow.</div>
    </a>
    <a class="qa-card" href="dashboard/history">
        <div class="qa-icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#3548d4" stroke-width="2"><circle cx="12" cy="12" r="9"></circle><path d="M12 7v5l3.5 2"></path></svg></div>
        <div class="qa-title">View history</div>
        <div class="qa-desc">Browse minute sheets you've submitted and their approval progress.</div>
    </a>
    <a class="qa-card" href="dashboard/actions">
        <div class="qa-icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#3548d4" stroke-width="2"><path d="M9 12l2 2 4-4"></path><circle cx="12" cy="12" r="9"></circle></svg></div>
        <div class="qa-title">Actions</div>
        <div class="qa-desc">Sheets waiting on your review, approval, or resolution.</div>
    </a>
</div>

<div class="section-title">Recent activity</div>
<div class="activity-card">
    @if (_recent.Count == 0)
    {
        <div style="padding:22px;color:#9296ab;font-size:14px;">No minute sheets yet. Create your first one.</div>
    }
    else
    {
        @foreach (var sheet in _recent)
        {
            var status = ApprovalWorkflow.StatusFor(sheet);
            <a class="activity-row" href="dashboard/sheet/@sheet.Token">
                <div style="flex:1;min-width:0;">
                    <div class="activity-title">@(sheet.Category == SheetCategory.NonFinancial ? "Non-Financial" : "Financial") minute sheet</div>
                    <div class="activity-meta">@sheet.CreatedAt.ToLocalTime().ToString("dd MMM yyyy, HH:mm") · @ApprovalWorkflow.ApprovedCount(sheet.ApprovalSteps) / @sheet.ApprovalSteps.Count approved</div>
                </div>
                <span class="badge @(status == "Approved" ? "bg-success" : "bg-warning")">@status</span>
            </a>
        }
    }
</div>

@code {
    private string _firstName = "there";
    private int _pendingApproval;
    private int _reviewsToResolve;
    private int _approved;
    private int _total;
    private List<MinuteSheet> _recent = new();
    private List<(string Label, int Count)> _monthly = new();

    private string Greeting => DateTime.Now.Hour switch
    {
        < 12 => "Good morning",
        < 18 => "Good afternoon",
        _ => "Good evening"
    };

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = await UserManager.GetUserAsync(authState.User);
        if (user is null)
        {
            return;
        }

        var name = string.IsNullOrWhiteSpace(user.FullName) ? (user.Email ?? "there") : user.FullName;
        _firstName = name.Split(' ', StringSplitOptions.RemoveEmptyEntries).FirstOrDefault() ?? "there";
        var email = user.Email ?? "";

        _pendingApproval = await DbContext.ApprovalSteps
            .CountAsync(s => s.ApproverEmail == email && s.Status != ApprovalStepStatus.Approved);

        var mySheets = await DbContext.MinuteSheets
            .Where(m => m.CreatedByUserId == user.Id)
            .Include(m => m.ApprovalSteps)
            .OrderByDescending(m => m.CreatedAt)
            .ToListAsync();

        _total = mySheets.Count;
        _approved = mySheets.Count(m => ApprovalWorkflow.IsFullyApproved(m.ApprovalSteps));
        _reviewsToResolve = mySheets.Count(m => m.ApprovalSteps.Any(s => s.Status == ApprovalStepStatus.Reviewed));
        _recent = mySheets.Take(5).ToList();

        // Sheets created per month over the trailing 6-month window (oldest first).
        var firstOfThisMonth = new DateTime(DateTime.Now.Year, DateTime.Now.Month, 1);
        for (var i = 5; i >= 0; i--)
        {
            var month = firstOfThisMonth.AddMonths(-i);
            var count = mySheets.Count(m =>
            {
                var d = m.CreatedAt.ToLocalTime();
                return d.Year == month.Year && d.Month == month.Month;
            });
            _monthly.Add((month.ToString("MMM"), count));
        }
    }
}
