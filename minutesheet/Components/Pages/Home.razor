@page "/"
@rendermode InteractiveServer

@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using System.Globalization
@using System.Text
@using minutesheet.Data

@attribute [Authorize]

@inject ApplicationDbContext DbContext
@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>Dashboard</PageTitle>

<style>
    :root {
        --page-bg: #f3f4fb;
        --card-bg: #ffffff;
        --border-color: #eef0f6;
        --text-primary: #14173a;
        --text-secondary: #6b7086;
        --text-muted: #9296ab;
        --hover-bg: #f8f9fd;
        --track-bg: #f1f2f8;
        --header-bg: #fafafe;
    }

    body[data-theme="dark"] {
        --page-bg: #0e1024;
        --card-bg: #171a35;
        --border-color: #272b52;
        --text-primary: #f3f4fb;
        --text-secondary: #b7bbe0;
        --text-muted: #8890a6;
        --hover-bg: #1e2142;
        --track-bg: #21254a;
        --header-bg: #1b1e3d;
    }

        /* ---------- Dark-theme UI tweaks (icons / badges / chart tracks) ---------- */
        body[data-theme="dark"] .stat-icon-amber {
            background: #3a2f14;
            color: #f0a83a;
        }

        body[data-theme="dark"] .stat-icon-blue {
            background: #1e2548;
            color: #8b9bff;
        }

        body[data-theme="dark"] .stat-icon-green {
            background: #14342a;
            color: #3dd994;
        }

        body[data-theme="dark"] .stat-icon-navy {
            background: #1f2340;
            color: #c6cbf5;
        }

        body[data-theme="dark"] .spark i {
            background: #262a4a;
        }

        body[data-theme="dark"] .bar-seg {
            background: linear-gradient(180deg, #1d2140, #1a1e3a);
        }

            body[data-theme="dark"] .bar-seg.total {
                background: linear-gradient(180deg, #232749, #202441);
            }

        body[data-theme="dark"] .bar-fill-total {
            background: linear-gradient(180deg, #4a4f86, #3b4068);
        }

        body[data-theme="dark"] .bg-success {
            background: #14342a;
            color: #3dd994;
        }

        body[data-theme="dark"] .bg-warning {
            background: #3a2f14;
            color: #f0a83a;
        }

        body[data-theme="dark"] .bg-info {
            background: #1e2548;
            color: #8b9bff;
        }

        body[data-theme="dark"] .trend-badge.up {
            background: #14342a;
            color: #3dd994;
        }

        body[data-theme="dark"] .trend-badge.down {
            background: #3a1d1d;
            color: #ff7b6b;
        }

    .dash-wrap {
        max-width: 1320px;
        background: var(--page-bg);
        padding: 4px;
        border-radius: 20px;
        transition: background .25s ease;
    }

    /* ---------- Top bar ---------- */
    .topbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 18px;
        margin-bottom: 22px;
        flex-wrap: wrap;
    }

    .topbar-left {
        min-width: 140px;
    }

    .topbar-title {
        font-size: 20px;
        font-weight: 800;
        color: var(--text-primary);
    }

    .topbar-date {
        display: flex;
        align-items: center;
        gap: 6px;
        font-size: 12.5px;
        color: var(--text-muted);
        margin-top: 3px;
    }

    .topbar-right {
        display: flex;
        align-items: center;
        gap: 10px;
        flex-wrap: wrap;
    }

    /* ---------- Header action buttons ---------- */
    .hdr-actions {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-right: 4px;
        flex-wrap: wrap;
    }

    .btn-hdr {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        font-size: 13px;
        font-weight: 700;
        padding: 9px 16px;
        border-radius: 11px;
        border: 1px solid var(--border-color);
        background: var(--card-bg);
        color: var(--text-secondary);
        text-decoration: none;
        cursor: pointer;
        transition: background .2s ease, transform .15s ease, box-shadow .2s ease;
        white-space: nowrap;
    }

        .btn-hdr:hover {
            background: var(--hover-bg);
            transform: translateY(-1px);
            box-shadow: 0 6px 18px rgba(20, 23, 58, .08);
        }

    .btn-hdr-primary {
        background: linear-gradient(135deg, #4f46e5, #6366f1);
        border-color: transparent;
        color: #fff;
    }

        .btn-hdr-primary:hover {
            background: linear-gradient(135deg, #4338ca, #4f46e5);
            color: #fff;
        }

    .icon-btn {
        position: relative;
        width: 38px;
        height: 38px;
        border-radius: 11px;
        border: 1px solid var(--border-color);
        background: var(--card-bg);
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--text-secondary);
        cursor: pointer;
        transition: background .2s ease, transform .15s ease;
        flex-shrink: 0;
    }

        .icon-btn:hover {
            background: var(--hover-bg);
            transform: translateY(-1px);
        }

    .dot-badge {
        position: absolute;
        top: -4px;
        right: -4px;
        background: #e2554a;
        color: #fff;
        font-size: 10px;
        font-weight: 700;
        min-width: 16px;
        height: 16px;
        border-radius: 999px;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 0 4px;
    }

    .notif-wrap {
        position: relative;
    }

    .notif-panel {
        position: absolute;
        top: 46px;
        right: 0;
        width: 300px;
        max-height: 340px;
        overflow-y: auto;
        background: var(--card-bg);
        border: 1px solid var(--border-color);
        border-radius: 14px;
        box-shadow: 0 12px 30px rgba(20, 23, 58, .14);
        z-index: 40;
        padding: 6px;
    }

    .notif-head {
        font-size: 12px;
        font-weight: 700;
        color: var(--text-secondary);
        padding: 10px 12px 6px;
    }

    .notif-empty {
        font-size: 12.5px;
        color: var(--text-muted);
        padding: 14px 12px;
    }

    .notif-item {
        padding: 10px 12px;
        border-radius: 10px;
        cursor: pointer;
        transition: background .15s ease;
    }

        .notif-item:hover {
            background: var(--hover-bg);
        }

    .notif-title {
        font-size: 12.5px;
        font-weight: 700;
        color: var(--text-primary);
    }

    .notif-sub {
        font-size: 11.5px;
        color: var(--text-muted);
        margin-top: 2px;
    }

    .user-chip {
        display: flex;
        align-items: center;
        gap: 9px;
        padding: 5px 12px 5px 5px;
        border-radius: 12px;
        border: 1px solid var(--border-color);
        background: var(--card-bg);
        cursor: default;
    }

    .avatar {
        width: 30px;
        height: 30px;
        border-radius: 50%;
        background: linear-gradient(135deg, #4f46e5, #818cf8);
        color: #fff;
        font-weight: 700;
        font-size: 12.5px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        overflow: hidden;
    }

    .user-name {
        font-size: 13px;
        font-weight: 700;
        color: var(--text-primary);
        line-height: 1.2;
    }

    .user-role {
        font-size: 11px;
        color: var(--text-muted);
    }

    .dash-header {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 16px;
        margin-bottom: 26px;
        flex-wrap: wrap;
    }

    .dash-greeting-title {
        font-size: 26px;
        font-weight: 700;
        color: var(--text-primary);
        letter-spacing: -0.02em;
    }

    .dash-greeting-sub {
        font-size: 14px;
        color: var(--text-muted);
        margin-top: 4px;
        display: flex;
        align-items: center;
        gap: 6px;
    }

    .section-title {
        font-size: 15px;
        font-weight: 700;
        color: var(--text-primary);
        margin: 30px 0 14px;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .section-link {
        font-size: 12.5px;
        font-weight: 700;
        color: #3548d4;
        text-decoration: none;
    }

        .section-link:hover {
            text-decoration: underline;
        }

    /* ---------- Stat cards ---------- */
    .stat-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 18px;
    }

    @@media (max-width: 1100px) {
        .stat-grid {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @@media (max-width: 560px) {
        .stat-grid {
            grid-template-columns: 1fr;
        }
    }

    .stat-card {
        background: var(--card-bg);
        border: 1px solid var(--border-color);
        border-radius: 18px;
        padding: 20px 20px 16px;
        box-shadow: 0 1px 2px rgba(20, 23, 58, .04);
        transition: box-shadow .2s ease, transform .2s ease, background .25s ease, border-color .25s ease;
    }

        .stat-card:hover {
            box-shadow: 0 10px 26px rgba(20, 23, 58, .09);
            transform: translateY(-2px);
        }

    .stat-top {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 10px;
    }

    .stat-label {
        font-size: 12px;
        font-weight: 600;
        color: var(--text-secondary);
    }

    .stat-icon {
        width: 38px;
        height: 38px;
        border-radius: 11px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .stat-icon-amber {
        background: #fff4e0;
        color: #b26a00;
    }

    .stat-icon-blue {
        background: #e8eaff;
        color: #3548d4;
    }

    .stat-icon-green {
        background: #e1f6ec;
        color: #17875a;
    }

    .stat-icon-navy {
        background: #eceefc;
        color: #14173a;
    }

    .stat-value {
        font-size: 30px;
        font-weight: 800;
        color: var(--text-primary);
        line-height: 1.15;
        margin-top: 10px;
    }

    .stat-bottom {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        margin-top: 14px;
        gap: 10px;
    }

    .stat-sub {
        font-size: 12px;
        color: var(--text-muted);
    }

    .spark {
        display: flex;
        align-items: flex-end;
        gap: 4px;
        height: 32px;
    }

        .spark i {
            display: block;
            width: 4px;
            border-radius: 3px;
            background: #eceefa;
            min-height: 4px;
        }

            .spark i.on-amber {
                background: linear-gradient(180deg, #ffd28a, #e2a138);
            }

            .spark i.on-blue {
                background: linear-gradient(180deg, #a5abf0, #3548d4);
            }

            .spark i.on-green {
                background: linear-gradient(180deg, #7bd7ab, #17875a);
            }

            .spark i.on-navy {
                background: linear-gradient(180deg, #6b7086, #14173a);
            }

    /* ---------- Overview grid ---------- */
    .chart-grid {
        display: grid;
        grid-template-columns: 1.7fr 1fr;
        gap: 18px;
    }

    @@media (max-width: 980px) {
        .chart-grid {
            grid-template-columns: 1fr;
        }
    }

    .chart-card {
        background: var(--card-bg);
        border: 1px solid var(--border-color);
        border-radius: 20px;
        padding: 22px;
        box-shadow: 0 1px 2px rgba(20, 23, 58, .04);
        transition: background .25s ease, border-color .25s ease;
    }

    .chart-head {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 6px;
    }

        .chart-head h3 {
            font-size: 15px;
            font-weight: 700;
            color: var(--text-primary);
            margin: 0;
        }

    .chart-legend-top {
        display: flex;
        gap: 16px;
        font-size: 12px;
        font-weight: 600;
        color: var(--text-secondary);
        margin-bottom: 18px;
    }

        .chart-legend-top span {
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .chart-legend-top i {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            display: inline-block;
        }

    .bar-pct-row {
        display: flex;
        align-items: flex-end;
        gap: 14px;
        height: 18px;
        margin-bottom: 6px;
    }

    .bar-pct-cell {
        flex: 1;
        text-align: center;
        font-size: 11px;
        font-weight: 800;
        color: #b7bbe0;
    }

        .bar-pct-cell.current {
            color: #4f46e5;
        }

    .bar-chart {
        position: relative;
        display: flex;
        align-items: flex-end;
        gap: 14px;
        height: 210px;
        padding-top: 4px;
        overflow: hidden;
        border-radius: 10px;
    }

    .bar-col {
        flex: 1;
        position: relative;
        display: flex;
        flex-direction: column;
        align-items: center;
        height: 100%;
        justify-content: flex-end;
        gap: 8px;
    }

    .bar-track {
        width: 100%;
        max-width: 38px;
        height: 100%;
        display: flex;
        align-items: flex-end;
        gap: 3px;
    }

    .bar-seg {
        flex: 1;
        display: flex;
        align-items: flex-end;
        background: linear-gradient(180deg, #f4f5fb, #eef0fa);
        border-radius: 7px;
        overflow: hidden;
        height: 100%;
    }

        .bar-seg.total {
            background: linear-gradient(180deg, #eef0fa, #e4e7fb);
        }

    .bar-fill-total {
        width: 100%;
        background: linear-gradient(180deg, #c7cbf7, #a5abf0);
        border-radius: 7px;
        min-height: 3px;
        transition: height .6s ease;
    }

    .bar-fill-approved {
        width: 100%;
        background: linear-gradient(180deg, #818cf8, #4f46e5);
        border-radius: 7px;
        min-height: 3px;
        transition: height .6s ease;
    }

    .bar-lbl {
        font-size: 11px;
        color: var(--text-muted);
        font-weight: 600;
        white-space: nowrap;
    }

        .bar-lbl.current {
            color: #4f46e5;
            font-weight: 800;
        }

    .scan-line {
        position: absolute;
        left: 8px;
        right: 8px;
        height: 2px;
        top: 6%;
        background: linear-gradient(90deg, transparent, #6366f1 20%, #a5b4fc 50%, #6366f1 80%, transparent);
        box-shadow: 0 0 10px 1px rgba(99, 102, 241, .5);
        border-radius: 2px;
        pointer-events: none;
        opacity: .85;
        animation: dashScan 3.6s ease-in-out infinite;
    }

    @@keyframes dashScan {
        0% {
            top: 6%;
            opacity: .35;
        }

        50% {
            top: 88%;
            opacity: .9;
        }

        100% {
            top: 6%;
            opacity: .35;
        }
    }

    /* ---------- Trend card ---------- */
    .trend-card {
        display: flex;
        flex-direction: column;
    }

    .trend-head {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 10px;
        margin-bottom: 4px;
    }

    .trend-title {
        font-size: 15px;
        font-weight: 700;
        color: var(--text-primary);
    }

    .trend-sub {
        font-size: 12px;
        color: var(--text-muted);
        margin-top: 2px;
    }

    .trend-badge {
        font-size: 11.5px;
        font-weight: 800;
        padding: 5px 10px;
        border-radius: 999px;
        white-space: nowrap;
    }

        .trend-badge.up {
            background: #e1f6ec;
            color: #17875a;
        }

        .trend-badge.down {
            background: #ffe4e2;
            color: #c0392b;
        }

    .trend-num {
        font-size: 32px;
        font-weight: 800;
        color: var(--text-primary);
        line-height: 1.1;
        margin: 6px 0 10px;
    }

    .trend-chart {
        flex: 1;
        display: flex;
        align-items: flex-end;
        min-height: 0;
    }

        .trend-chart svg {
            display: block;
            width: 100%;
        }

    .trend-labels {
        display: flex;
        justify-content: space-between;
        margin-top: 8px;
    }

        .trend-labels span {
            font-size: 11px;
            color: var(--text-muted);
            font-weight: 600;
        }

    /* ---------- Upcoming actions ---------- */
    .ua-row {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 14px 0;
        border-bottom: 1px solid var(--border-color);
        cursor: pointer;
        transition: background .15s ease;
    }

    /* ---------- Second row ---------- */
    .row2-grid {
        display: grid;
        grid-template-columns: 1fr 1.4fr;
        gap: 18px;
    }

        .ua-row:hover {
            background: var(--hover-bg);
        }

    .ua-dot {
        width: 9px;
        height: 9px;
        border-radius: 50%;
        flex-shrink: 0;
    }

    .ua-main {
        flex: 1;
        min-width: 0;
    }

    .ua-title {
        font-size: 13px;
        font-weight: 700;
        color: var(--text-primary);
    }

    .ua-sub {
        font-size: 11.5px;
        color: var(--text-muted);
        margin-top: 2px;
    }

    /* ---------- Recent sheets table (full width) ---------- */
    .table-card {
        padding: 0;
        overflow: hidden;
    }

        .table-card .chart-head {
            padding: 22px 22px 14px;
            margin-bottom: 0;
        }

    table.sheets-table {
        width: 100%;
        border-collapse: collapse;
    }

        table.sheets-table th {
            text-align: left;
            font-size: 11px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: .04em;
            color: var(--text-muted);
            padding: 10px 22px;
            border-top: 1px solid var(--border-color);
            border-bottom: 1px solid var(--border-color);
            background: var(--header-bg);
        }

        table.sheets-table td {
            padding: 14px 22px;
            border-bottom: 1px solid var(--border-color);
            font-size: 13px;
            color: var(--text-secondary);
        }

        table.sheets-table tr:last-child td {
            border-bottom: none;
        }

        table.sheets-table tr.clickable {
            cursor: pointer;
            transition: background .15s ease;
        }

            table.sheets-table tr.clickable:hover {
                background: var(--hover-bg);
            }

    .sheet-ref {
        font-weight: 700;
        color: #3548d4;
    }

    .sheet-cat {
        font-weight: 700;
        color: var(--text-primary);
    }

    .empty-cell {
        padding: 26px 22px;
        color: var(--text-muted);
        font-size: 13.5px;
    }

    .badge {
        font-size: 11px;
        font-weight: 700;
        padding: 5px 12px;
        border-radius: 999px;
        white-space: nowrap;
    }

    .bg-success {
        background: #e1f6ec;
        color: #17875a;
    }

    .bg-warning {
        background: #fff4e0;
        color: #b26a00;
    }

    .bg-info {
        background: #e8eaff;
        color: #3548d4;
    }

    /* ---------- Approvers column ---------- */
    .by-stack {
        display: flex;
        flex-direction: column;
        gap: 6px;
    }

    .by-chip {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .by-avatar {
        width: 22px;
        height: 22px;
        border-radius: 50%;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        color: #fff;
        font-size: 10px;
        font-weight: 700;
        flex-shrink: 0;
    }

    .by-name {
        font-size: 12.5px;
        color: var(--text-secondary);
        font-weight: 600;
    }

    /* ---------- Responsive header ---------- */
    @@media (max-width: 900px) {
        .hdr-actions {
            order: 3;
            width: 100%;
            margin-right: 0;
        }
    }

    @@media (max-width: 520px) {
        .btn-hdr {
            flex: 1;
            justify-content: center;
        }
    }
</style>

@{
    var maxMonth = _monthly.Count == 0 ? 0 : _monthly.Max(m => m.Count);
    var done = _approved;
    var inProgress = Math.Max(0, _total - _approved);
    var pendingCount = _pendingApproval;
    string F(double v) => v.ToString("0.##", CultureInfo.InvariantCulture);

    var progressDenom = Math.Max(1, done + _reviewsToResolve + pendingCount);
    var approvedPct = done * 100.0 / progressDenom;
    var reviewPct = _reviewsToResolve * 100.0 / progressDenom;
    var pendingPct = pendingCount * 100.0 / progressDenom;
    var alerts = _pendingApproval + _reviewsToResolve;

    // Trend card data (approved count per month)
    var trendCounts = _monthlyApproved.Select(x => (double)x.Count).ToArray();
    var trendPts = TrendPoints(trendCounts, 300, 120);
    var trendLine = SmoothPath(trendCounts, 300, 120);
    var trendFill = SmoothAreaFill(trendCounts, 300, 120);
    var approvedThisMonth = _monthlyApproved.Count > 0 ? _monthlyApproved[^1].Count : 0;
    var approvedLastMonth = _monthlyApproved.Count > 1 ? _monthlyApproved[^2].Count : 0;
    var trendPct = approvedLastMonth == 0
        ? (approvedThisMonth > 0 ? 100.0 : 0.0)
        : (approvedThisMonth - approvedLastMonth) * 100.0 / approvedLastMonth;
}

<div class="dash-wrap">

    <div class="topbar">
        <div class="topbar-left">
            <div class="topbar-title">Dashboard</div>
            <div class="topbar-date">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2"></rect><path d="M16 2v4M8 2v4M3 10h18"></path></svg>
                @DateTime.Now.ToString("dd MMM yyyy")
            </div>
        </div>

        <div class="topbar-right">
            @* Hidden header quick-action buttons (Create New Sheet / History / Actions).
               They are still available in the sidebar NavMenu, so this just removes
               them from the dashboard top bar. To restore, delete this comment block. *@
            @*<div class="hdr-actions">
                <a class="btn-hdr btn-hdr-primary" href="dashboard/create">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 5v14M5 12h14"></path></svg>
                    Create New Sheet
                </a>
                <a class="btn-hdr" href="dashboard/history">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"></circle><path d="M12 7v5l3.5 2"></path></svg>
                    History
                </a>
                <a class="btn-hdr" href="dashboard/actions">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 12l2 2 4-4"></path><circle cx="12" cy="12" r="9"></circle></svg>
                    Actions
                </a>
            </div>*@

            <!-- Theme toggle (sun / moon) -->
            <button type="button" class="icon-btn" @onclick="ToggleTheme" title="Toggle theme">
                @if (_isDark)
                {
                    <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path></svg>
                }
                else
                {
                    <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path></svg>
                }
            </button>

            <!-- Notifications bell + dropdown panel -->
            <div class="notif-wrap">
                <button type="button" class="icon-btn" title="Notifications" @onclick="ToggleNotifications">
                    <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 8a6 6 0 0 1 12 0c0 5 2 6 2 6H4s2-1 2-6"></path><path d="M10 20a2 2 0 0 0 4 0"></path></svg>
                    @if (alerts > 0)
                    {
                        <span class="dot-badge">@alerts</span>
                    }
                </button>

                @if (_showNotifications)
                {
                    <div class="notif-panel">
                        <div class="notif-head">Notifications</div>
                        @if (_pendingSteps.Count == 0)
                        {
                            <div class="notif-empty">You're all caught up.</div>
                        }
                        else
                        {
                            @foreach (var step in _pendingSteps)
                            {
                                var isReview = step.Status == ApprovalStepStatus.Reviewed;
                                <div class="notif-item" @onclick="() => GoToSheet(step)">
                                    <div class="notif-title">@(isReview ? "Review sent back to you" : "Awaiting your approval")</div>
                                    <div class="notif-sub">@(step.MinuteSheet.Category == SheetCategory.NonFinancial ? "Non-Financial" : "Financial") sheet · @step.MinuteSheet.CreatedAt.ToLocalTime().ToString("dd MMM")</div>
                                </div>
                            }
                        }
                    </div>
                }
            </div>

            <!-- Signed-in user chip (avatar + name + role) -->
            <div class="user-chip">
                <div class="avatar">
                    @if (!string.IsNullOrEmpty(_avatarPath))
                    {
                        <img src="/@_avatarPath" alt="Profile" style="width:100%;height:100%;border-radius:50%;object-fit:cover;" />
                    }
                    else
                    {
                        @(_firstName.Length > 0 ? _firstName.Substring(0, 1).ToUpper() : "U")
                    }
                </div>
                <div>
                    <div class="user-name">@_firstName</div>
                    <div class="user-role">Member</div>
                </div>
            </div>
        </div>
    </div>

    <div class="dash-header">
        <div>
            <div class="dash-greeting-title">@Greeting, @_firstName</div>
            <div class="dash-greeting-sub">@DateTime.Now.ToString("dddd, dd MMMM") · here's what's happening with your minute sheets.</div>
        </div>
    </div>

    <div class="stat-grid">
        <div class="stat-card">
            <div class="stat-top">
                <div class="stat-label">Pending your approval</div>
                <div class="stat-icon stat-icon-amber">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"></circle><path d="M12 7v5l3.2 2"></path></svg>
                </div>
            </div>
            <div class="stat-value">@_pendingApproval</div>
            <div class="stat-bottom">
                <div class="stat-sub">awaiting your action</div>
                <div class="spark">
                    @foreach (var m in _monthly)
                    {
                        var h = maxMonth == 0 ? 8 : Math.Max(4, (int)Math.Round(m.Count * 30.0 / maxMonth));
                        <i class="@(m.Count > 0 ? "on-amber" : "")" style="height:@(h)px"></i>
                    }
                </div>
            </div>
        </div>

        <div class="stat-card">
            <div class="stat-top">
                <div class="stat-label">Reviews to resolve</div>
                <div class="stat-icon stat-icon-blue">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a9 9 0 1 1-2.6-6.36"></path><path d="M21 4v5h-5"></path></svg>
                </div>
            </div>
            <div class="stat-value">@_reviewsToResolve</div>
            <div class="stat-bottom">
                <div class="stat-sub">sent back to you</div>
                <div class="spark">
                    @foreach (var m in _monthly)
                    {
                        var h = maxMonth == 0 ? 8 : Math.Max(4, (int)Math.Round(m.Count * 30.0 / maxMonth));
                        <i class="@(m.Count > 0 ? "on-blue" : "")" style="height:@(h)px"></i>
                    }
                </div>
            </div>
        </div>

        <div class="stat-card">
            <div class="stat-top">
                <div class="stat-label">Approved</div>
                <div class="stat-icon stat-icon-green">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"></circle><path d="M8.5 12.5l2.3 2.3L16 9.7"></path></svg>
                </div>
            </div>
            <div class="stat-value">@_approved</div>
            <div class="stat-bottom">
                <div class="stat-sub">of your sheets</div>
                <div class="spark">
                    @foreach (var m in _monthly)
                    {
                        var h = maxMonth == 0 ? 8 : Math.Max(4, (int)Math.Round(m.Count * 30.0 / maxMonth));
                        <i class="@(m.Count > 0 ? "on-green" : "")" style="height:@(h)px"></i>
                    }
                </div>
            </div>
        </div>

        <div class="stat-card">
            <div class="stat-top">
                <div class="stat-label">Total sheets</div>
                <div class="stat-icon stat-icon-navy">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"></path><path d="M14 3v5h5"></path><path d="M9 13h6M9 17h6"></path></svg>
                </div>
            </div>
            <div class="stat-value">@_total</div>
            <div class="stat-bottom">
                <div class="stat-sub">you've created</div>
                <div class="spark">
                    @foreach (var m in _monthly)
                    {
                        var h = maxMonth == 0 ? 8 : Math.Max(4, (int)Math.Round(m.Count * 30.0 / maxMonth));
                        <i class="@(m.Count > 0 ? "on-navy" : "")" style="height:@(h)px"></i>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="section-title">Overview</div>
    <div class="chart-grid">

        <div class="chart-card">
            <div class="chart-head"><h3>Sheets Overview</h3></div>
            <div class="chart-legend-top">
                <span><i style="background:#a5abf0"></i>Total sheets</span>
                <span><i style="background:#4f46e5"></i>Approved · @(_total > 0 ? $"{(int)Math.Round(_approved * 100.0 / _total)}%" : "0%")</span>
            </div>
            @{
                var currentMonthLabel = DateTime.Now.ToString("MMM");
            }
            <div class="bar-pct-row">
                @foreach (var m in _monthly)
                {
                    var share = m.Count == 0 ? 0 : (int)Math.Round(_monthlyApproved.FirstOrDefault(x => x.Label == m.Label).Count * 100.0 / m.Count);
                    <div class="bar-pct-cell @(m.Label == currentMonthLabel ? "current" : "")">@share%</div>
                }
            </div>
            <div class="bar-chart">
                <div class="scan-line"></div>
                @foreach (var m in _monthly)
                {
                    var totalH = maxMonth == 0 ? 0 : (int)Math.Round(m.Count * 100.0 / maxMonth);
                    var approvedForMonth = _monthlyApproved.FirstOrDefault(x => x.Label == m.Label).Count;
                    var approvedH = maxMonth == 0 ? 0 : (int)Math.Round(approvedForMonth * 100.0 / maxMonth);
                    <div class="bar-col">
                        <div class="bar-track">
                            <div class="bar-seg total"><div class="bar-fill-total" style="height:@(totalH)%"></div></div>
                            <div class="bar-seg"><div class="bar-fill-approved" style="height:@(approvedH)%"></div></div>
                        </div>
                        <div class="bar-lbl @(m.Label == currentMonthLabel ? "current" : "")">@m.Label</div>
                    </div>
                }
            </div>
        </div>

        <div class="chart-card trend-card">
            <div class="trend-head">
                <div>
                    <div class="trend-title">Sheets Approved</div>
                    <div class="trend-sub">All-time approved minute sheets</div>
                </div>
                <span class="trend-badge @(trendPct >= 0 ? "up" : "down")">
                    @(trendPct >= 0 ? "↑" : "↓") @F(Math.Abs(trendPct))%
                </span>
            </div>
            <div class="trend-num">@_approved</div>
            <div class="trend-chart">
                <svg viewBox="0 0 300 120" width="100%" height="120" preserveAspectRatio="none">
                    <defs>
                        <linearGradient id="trendFillGrad" x1="0" y1="0" x2="0" y2="1">
                            <stop offset="0%" stop-color="#4f46e5" stop-opacity="0.35"></stop>
                            <stop offset="100%" stop-color="#4f46e5" stop-opacity="0.02"></stop>
                        </linearGradient>
                    </defs>
                    <path d="@trendFill" fill="url(#trendFillGrad)" stroke="none"></path>
                    <path d="@trendLine" fill="none" stroke="#4f46e5" stroke-width="2.5" stroke-linecap="round"></path>
                    @for (var i = 0; i < trendPts.Count; i++)
                    {
                        <circle cx="@F(trendPts[i].X)" cy="@F(trendPts[i].Y)" r="3.5" fill="#fff" stroke="#4f46e5" stroke-width="2"></circle>
                    }
                </svg>
            </div>
            <div class="trend-labels">
                @foreach (var m in _monthlyApproved)
                {
                    <span>@m.Label</span>
                }
            </div>
        </div>
    </div>

    <div class="section-title">
        <span>My upcoming actions</span>
        <a class="section-link" href="dashboard/actions">View all</a>
    </div>
    <div class="chart-card" style="padding:6px 22px;">
        @if (_pendingSteps.Count == 0)
        {
            <div class="empty-cell">Nothing waiting on you right now.</div>
        }
        else
        {
            @foreach (var step in _pendingSteps.Take(4))
            {
                var isReview = step.Status == ApprovalStepStatus.Reviewed;
                <div class="ua-row" @onclick="() => GoToSheet(step)">
                    <span class="ua-dot" style="background:@(isReview ? "#3548d4" : "#e2a138")"></span>
                    <div class="ua-main">
                        <div class="ua-title">@step.MinuteSheet.Title</div>
                        <div class="ua-sub">@(isReview ? "Review" : "Approve") · @(step.MinuteSheet.Category == SheetCategory.NonFinancial ? "Non-Financial" : "Financial") · @step.MinuteSheet.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")</div>
                    </div>
                    <span class="badge bg-warning">@(isReview ? "Needs review" : "Pending")</span>
                </div>
            }
        }
    </div>

    <div class="section-title">
        <span>Recent sheets</span>
        <a class="section-link" href="dashboard/history">View all</a>
    </div>
    <div class="chart-card table-card">
        <table class="sheets-table">
            <thead>
                <tr>
                    <th>Ref</th>
                    <th>Category</th>
                    <th>Date</th>
                    <th>Progress</th>
                    <th>Approvals</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                @if (_recent.Count == 0)
                {
                    <tr><td colspan="6" class="empty-cell">No minute sheets yet. Create your first one.</td></tr>
                }
                else
                {
                    @for (var i = 0; i < _recent.Count; i++)
                    {
                        var sheet = _recent[i];
                        var status = ApprovalWorkflow.StatusFor(sheet);
                        var approvedSteps = ApprovalWorkflow.ApprovedCount(sheet.ApprovalSteps);
                        var badgeClass = status switch
                        {
                            "Approved" => "bg-success",
                            "Review" => "bg-info",
                            _ => "bg-warning"
                        };
                        <tr class="clickable" @onclick='() => Nav.NavigateTo($"dashboard/sheet/{sheet.Token}")'>
                            <td class="sheet-ref">#@((i + 1).ToString("D3"))</td>
                            <td class="sheet-cat">@(sheet.Category == SheetCategory.NonFinancial ? "Non-Financial" : "Financial")</td>
                            <td>@sheet.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")</td>
                            <td>@approvedSteps / @sheet.ApprovalSteps.Count approved</td>
                            <td>
                                @{
                                    var by = sheet.ApprovalSteps
                                        .Where(s => s.Status == ApprovalStepStatus.Approved || s.Status == ApprovalStepStatus.Reviewed)
                                        .ToList();
                                }
                                @if (by.Count == 0)
                                {
                                    <span style="color:var(--text-muted);font-size:12px;">—</span>
                                }
                                else
                                {
                                    <div class="by-stack">
                                        @foreach (var s in by)
                                        {
                                            var byName = _approverNames.TryGetValue(s.ApproverEmail, out var n) ? n : s.ApproverEmail;
                                            <div class="by-chip">
                                                <span class="by-avatar" style="background:@AvatarColor(byName)">@AvatarInitials(byName)</span>
                                                <span class="by-name">@byName</span>
                                            </div>
                                        }
                                    </div>
                                }
                            </td>
                            <td><span class="badge @badgeClass">@status</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

</div>

@code {
    private string _firstName = "there";
    private string? _avatarPath;
    private bool _isDark;
    private bool _showNotifications;
    private int _pendingApproval;
    private int _reviewsToResolve;
    private int _approved;
    private int _total;
    private List<MinuteSheet> _recent = new();
    private List<ApprovalStep> _pendingSteps = new();
    private List<(string Label, int Count)> _monthly = new();
    private List<(string Label, int Count)> _monthlyApproved = new();
    private Dictionary<string, string> _approverNames = new();

    private string Greeting => DateTime.Now.Hour < 12 ? "Good morning" : DateTime.Now.Hour < 18 ? "Good afternoon" : "Good evening";

    // ---- Smooth trend chart helpers ----

    private List<(double X, double Y)> TrendPoints(double[] values, double width, double height, double pad = 8)
    {
        var list = new List<(double X, double Y)>();
        if (values.Length == 0) return list;
        var max = values.Max();
        if (max <= 0) max = 1;
        var n = values.Length;
        for (var i = 0; i < n; i++)
        {
            var x = n == 1 ? width / 2 : pad + i * (width - 2 * pad) / (n - 1);
            var y = height - pad - (values[i] / max) * (height - 2 * pad);
            list.Add((x, y));
        }
        return list;
    }

    private string SmoothPath(double[] values, double width, double height, double pad = 8)
    {
        if (values.Length == 0) return "";
        var pts = TrendPoints(values, width, height, pad);
        if (pts.Count == 1)
            return $"M{F(pts[0].X)} {F(pts[0].Y)}";
        var sb = new StringBuilder();
        sb.Append("M").Append(F(pts[0].X)).Append(' ').Append(F(pts[0].Y));
        for (var i = 0; i < pts.Count - 1; i++)
        {
            var p0 = pts[Math.Max(i - 1, 0)];
            var p1 = pts[i];
            var p2 = pts[i + 1];
            var p3 = pts[Math.Min(i + 2, pts.Count - 1)];
            var c1x = p1.X + (p2.X - p0.X) / 6;
            var c1y = p1.Y + (p2.Y - p0.Y) / 6;
            var c2x = p2.X - (p3.X - p1.X) / 6;
            var c2y = p2.Y - (p3.Y - p1.Y) / 6;
            sb.Append(" C").Append(F(c1x)).Append(' ').Append(F(c1y))
              .Append(", ").Append(F(c2x)).Append(' ').Append(F(c2y))
              .Append(", ").Append(F(p2.X)).Append(' ').Append(F(p2.Y));
        }
        return sb.ToString();
        string F(double v) => v.ToString("0.##", CultureInfo.InvariantCulture);
    }

    private string SmoothAreaFill(double[] values, double width, double height, double pad = 8)
    {
        if (values.Length == 0) return "";
        var pts = TrendPoints(values, width, height, pad);
        var line = SmoothPath(values, width, height, pad);
        return $"{line} L{F(pts[^1].X)} {F(height)} L{F(pts[0].X)} {F(height)} Z";
        string F(double v) => v.ToString("0.##", CultureInfo.InvariantCulture);
    }

    // ---- Avatar helpers ----

    private static string AvatarInitials(string name)
    {
        var parts = (name ?? "?").Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 0) return "?";
        if (parts.Length == 1)
        {
            var w = parts[0];
            return (w.Length >= 2 ? w[..2] : w).ToUpperInvariant();
        }
        return (parts[0][..1] + parts[^1][..1]).ToUpperInvariant();
    }

    private static string AvatarColor(string name)
    {
        var h = Math.Abs((name ?? "?").GetHashCode());
        var r = 60 + h % 140;
        var g = 60 + (h >> 8) % 140;
        var b = 60 + (h >> 16) % 140;
        return $"rgb({r},{g},{b})";
    }

    // -------------------------------

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = await UserManager.GetUserAsync(authState.User);
        if (user is null)
        {
            return;
        }

        var name = string.IsNullOrWhiteSpace(user.FullName) ? (user.Email ?? "there") : user.FullName;
        _firstName = name.Split(' ', StringSplitOptions.RemoveEmptyEntries).FirstOrDefault() ?? "there";
        _avatarPath = user.AvatarPath;
        var email = user.Email ?? "";

        _pendingApproval = await DbContext.ApprovalSteps
            .CountAsync(s => s.ApproverEmail == email && s.Status != ApprovalStepStatus.Approved);

        _pendingSteps = await DbContext.ApprovalSteps
            .Where(s => s.ApproverEmail == email && s.Status != ApprovalStepStatus.Approved)
            .Include(s => s.MinuteSheet)
            .OrderByDescending(s => s.MinuteSheet.CreatedAt)
            .Take(6)
            .ToListAsync();

        var mySheets = await DbContext.MinuteSheets
            .Where(m => m.CreatedByUserId == user.Id)
            .Include(m => m.ApprovalSteps)
            .OrderByDescending(m => m.CreatedAt)
            .ToListAsync();

        _total = mySheets.Count;
        _approved = mySheets.Count(m => ApprovalWorkflow.IsFullyApproved(m.ApprovalSteps));
        _reviewsToResolve = mySheets.Count(m => m.ApprovalSteps.Any(s => s.Status == ApprovalStepStatus.Reviewed));
        _recent = mySheets.Take(5).ToList();

        var approverEmails = _recent
            .SelectMany(m => m.ApprovalSteps)
            .Where(s => s.Status == ApprovalStepStatus.Approved || s.Status == ApprovalStepStatus.Reviewed)
            .Select(s => s.ApproverEmail)
            .Distinct()
            .ToList();

        var approverUsers = await DbContext.Users
            .Where(u => approverEmails.Contains(u.Email ?? ""))
            .ToListAsync();
        _approverNames = approverUsers
            .Where(u => u.Email != null)
            .ToDictionary(
                u => u.Email!,
                u => string.IsNullOrWhiteSpace(u.FullName) ? u.Email! : u.FullName);

        var firstOfThisMonth = new DateTime(DateTime.Now.Year, DateTime.Now.Month, 1);
        for (var i = 5; i >= 0; i--)
        {
            var month = firstOfThisMonth.AddMonths(-i);
            var count = mySheets.Count(m =>
            {
                var d = m.CreatedAt.ToLocalTime();
                return d.Year == month.Year && d.Month == month.Month;
            });
            var approvedCount = mySheets.Count(m =>
            {
                var d = m.CreatedAt.ToLocalTime();
                return d.Year == month.Year && d.Month == month.Month && ApprovalWorkflow.IsFullyApproved(m.ApprovalSteps);
            });
            _monthly.Add((month.ToString("MMM"), count));
            _monthlyApproved.Add((month.ToString("MMM"), approvedCount));
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                var saved = await JS.InvokeAsync<string?>("localStorage.getItem", "ms-theme");
                _isDark = saved == "dark";
                StateHasChanged();
            }
            catch
            {
                // localStorage not available (e.g. prerender) — default to light.
            }
        }
    }

    private async Task ToggleTheme()
    {
        _isDark = !_isDark;
        var value = _isDark ? "dark" : "light";
        try
        {
            // Persist in both localStorage (client fallback) and a cookie (so the
            // server pre-renders every page with the correct theme — this is what
            // keeps dark mode applied across navigation without a reload).
            await JS.InvokeVoidAsync("eval",
                $"localStorage.setItem('ms-theme','{value}'); document.cookie = 'ms-theme={value}; path=/; max-age=31536000; SameSite=Lax'; document.body.dataset.theme = '{value}';");
        }
        catch
        {
            // ignore if storage unavailable
        }
    }

    private void ToggleNotifications()
    {
        _showNotifications = !_showNotifications;
    }

    private void GoToSheet(ApprovalStep step)
    {
        _showNotifications = false;
        Nav.NavigateTo($"dashboard/sheet/{step.MinuteSheet.Token}");
    }
}