@page "/settings"
@rendermode InteractiveServer

@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using minutesheet.Components.Account.Shared
@using minutesheet.Data

@attribute [Authorize]

@inject UserManager<ApplicationUser> UserManager
@inject ApplicationDbContext DbContext
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IWebHostEnvironment Env
@inject NavigationManager NavigationManager
@inject ILogger<Settings> Logger

<PageTitle>Settings</PageTitle>

<h1 class="page-title">Settings</h1>

<StatusMessage Message="@_message" />

<div class="content-card settings-card narrow" style="margin-bottom:20px;">
    <div style="font-size:16px;font-weight:600;color:#14173a;margin-bottom:2px;">Profile information</div>
    <div style="font-size:13px;color:#9296ab;margin-bottom:22px;">
        @(_isAdmin ? "Update the details associated with this account." : "This information is managed by an administrator.")
    </div>

    @if (_isAdmin)
    {
        <EditForm Model="Input" FormName="profile" OnValidSubmit="OnSaveProfileAsync" method="post"
                  enctype="multipart/form-data">
            <DataAnnotationsValidator />
            <ValidationSummary class="text-danger" role="alert" />

            <div class="d-flex align-items-center gap-3" style="margin-bottom:22px;">
                <div class="avatar-preview">
                    @if (!string.IsNullOrEmpty(_user?.AvatarPath))
                    {
                        <img src="@($"/{_user.AvatarPath}?v={_avatarVersion}")" alt="Profile picture" />
                    }
                    else
                    {
                        <span class="avatar-initials">@Initials(_user?.FullName, _email)</span>
                    }
                </div>
                <div>
                    <div style="font-size:13.5px;font-weight:600;color:#1a1d2e;margin-bottom:6px;">Profile picture</div>
                    <label class="upload-btn" for="avatar-input">
                        Upload new photo
                    </label>
                    <InputFile id="avatar-input" class="d-none" accept=".png,.jpg,.jpeg,.webp,.gif" OnChange="OnAvatarSelected" />
                    <div class="form-text" style="font-size:12px;">PNG, JPG, WEBP or GIF, up to 5 MB.</div>
                    @if (!string.IsNullOrEmpty(_avatarError))
                    {
                        <div class="text-danger small mt-1">@_avatarError</div>
                    }
                </div>
            </div>

            <div class="settings-grid">
                <div class="col-full">
                    <div class="field-label">Email</div>
                    <input type="text" value="@_email" class="form-control" disabled />
                    <div class="form-text">Email changes are managed from the account area.</div>
                </div>
                <div>
                    <div class="field-label">Full name</div>
                    <InputText @bind-Value="Input.FullName" class="form-control" autocomplete="name" placeholder="Full name" />
                    <ValidationMessage For="() => Input.FullName" class="text-danger" />
                </div>
                <div>
                    <div class="field-label">Employee No.</div>
                    <InputText @bind-Value="Input.EmployeeNo" class="form-control" placeholder="Employee number" />
                    <ValidationMessage For="() => Input.EmployeeNo" class="text-danger" />
                </div>
                <div>
                    <div class="field-label">Designation</div>
                    <InputSelect @bind-Value="Input.Designation" class="form-select">
                        @foreach (var d in Enum.GetValues<Designation>())
                        {
                            <option value="@d">@DisplayName(d)</option>
                        }
                    </InputSelect>
                    <ValidationMessage For="() => Input.Designation" class="text-danger" />
                </div>
                <div>
                    <div class="field-label">Department</div>
                    <InputSelect @bind-Value="Input.DepartmentId" class="form-select">
                        <option value="">-- Select department --</option>
                        @foreach (var dept in _departments)
                        {
                            <option value="@dept.Id">@dept.Name</option>
                        }
                    </InputSelect>
                    <ValidationMessage For="() => Input.DepartmentId" class="text-danger" />
                </div>
                <div class="col-full">
                    <div class="field-label">Phone number <span class="text-muted fw-normal">(optional)</span></div>
                    <InputText @bind-Value="Input.PhoneNumber" class="form-control" autocomplete="tel" placeholder="Phone number" />
                    <ValidationMessage For="() => Input.PhoneNumber" class="text-danger" />
                </div>
            </div>

            <button type="submit" class="btn btn-primary" style="border-radius:10px;padding:12px 26px;margin-top:22px;">Save changes</button>
        </EditForm>
    }
    else
    {
        <div class="avatar-preview" style="margin-bottom:18px;">
            @if (!string.IsNullOrEmpty(_user?.AvatarPath))
            {
                <img src="@($"/{_user.AvatarPath}?v={_avatarVersion}")" alt="Profile picture" />
            }
            else
            {
                <span class="avatar-initials">@Initials(_user?.FullName, _email)</span>
            }
        </div>

        <div class="settings-grid readonly">
            <div class="col-full">
                <div class="field-label">Email</div>
                <div class="static-value">@_email</div>
            </div>
            <div>
                <div class="field-label">Full name</div>
                <div class="static-value">@(_user?.FullName ?? "\u2014")</div>
            </div>
            <div>
                <div class="field-label">Employee No.</div>
                <div class="static-value">@(_user?.EmployeeNo ?? "\u2014")</div>
            </div>
            <div>
                <div class="field-label">Designation</div>
                <div class="static-value">@DisplayName(_user?.Designation ?? Designation.Executive)</div>
            </div>
            <div>
                <div class="field-label">Department</div>
                <div class="static-value">@CurrentDepartmentName()</div>
            </div>
            <div class="col-full">
                <div class="field-label">Phone number</div>
                <div class="static-value">@(_user?.PhoneNumber ?? "\u2014")</div>
            </div>
        </div>
    }
</div>

<div class="content-card settings-card narrow" style="margin-bottom:20px;">
    <div class="d-flex align-items-start justify-content-between" style="gap:16px;">
        <div>
            <div style="font-size:16px;font-weight:600;color:#14173a;margin-bottom:2px;">Two-factor authentication</div>
            <div style="font-size:13px;color:#9296ab;">Add an extra layer of security using an authenticator app.</div>
        </div>
        <span class="badge @(_is2faEnabled ? "bg-success" : "bg-warning")">@(_is2faEnabled ? "Enabled" : "Not enabled")</span>
    </div>

    <div style="margin-top:18px;">
        @if (_is2faEnabled)
        {
            <div style="font-size:13.5px;color:#565b78;margin-bottom:14px;">
                Two-factor authentication is on. You have <strong>@_recoveryCodesLeft</strong> recovery code@(_recoveryCodesLeft == 1 ? "" : "s") remaining.
            </div>
            <a href="settings/two-factor" class="btn btn-outline-primary">Manage 2FA</a>
        }
        else
        {
            <div style="font-size:13.5px;color:#565b78;margin-bottom:14px;">
                Require a one-time code from your authenticator app (Google Authenticator, Microsoft Authenticator, etc.) each time you sign in.
            </div>
            <a href="settings/two-factor" class="btn btn-primary" style="border-radius:10px;padding:12px 22px;">Set up authenticator app</a>
        }
    </div>
</div>

@if (_isAdmin)
{
    <div class="content-card settings-card narrow danger">
        <div style="font-size:16px;font-weight:600;color:#d33636;margin-bottom:2px;">Delete account</div>
        <div class="alert alert-danger" role="alert" style="margin:14px 0;">
            Deleting your account permanently removes it and all associated profile data.
            <strong>This cannot be undone.</strong>
        </div>

        @if (_deleteError is not null)
        {
            <div class="alert alert-danger" role="alert" style="margin:0 0 14px;">@_deleteError</div>
        }

        @* Posts to a dedicated endpoint (not this interactive circuit) so SignOutAsync can
           write the auth cookie during a real HTTP request. See /Account/DeleteAccount. *@
        <form action="Account/DeleteAccount" method="post">
            <AntiforgeryToken />

            @if (_requirePassword)
            {
                <div class="mb-3">
                    <div class="field-label">Confirm your password</div>
                    <input type="password" name="password" class="form-control"
                           autocomplete="current-password" placeholder="Current password" required />
                </div>
            }

            <button type="submit" class="btn btn-danger" style="border-radius:10px;padding:12px 24px;">Delete my account</button>
        </form>
    </div>
}

@code {
    private ApplicationUser _user = default!;
    private string? _email;
    private int? _originalDepartmentId;
    private bool _requirePassword;
    private bool _isAdmin;
    private string? _message;
    private string? _avatarError;
    private string? _deleteError;
    private string _avatarVersion = "1";
    private List<Department> _departments = new();
    private bool _is2faEnabled;
    private int _recoveryCodesLeft;

    private const long MaxAvatarBytes = 5 * 1024 * 1024;
    private static readonly string[] AllowedAvatarExtensions = { ".png", ".jpg", ".jpeg", ".webp", ".gif" };

    // Two forms share this page. During a POST, Blazor SSR sets the model of the
    // form that was NOT submitted to null, so null-coalescing setters keep both
    // models non-null and prevent "EditForm requires a Model" render errors.
    private ProfileModel _input = new();
    [SupplyParameterFromForm(FormName = "profile")]
    private ProfileModel Input { get => _input; set => _input = value ?? new(); }

    // Set when /Account/DeleteAccount redirects back after a failed deletion.
    [SupplyParameterFromQuery(Name = "deleteError")]
    private string? DeleteError { get; set; }

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        if (authState.User.Identity?.IsAuthenticated != true)
        {
            NavigationManager.NavigateTo("Account/Login", forceLoad: true);
            return;
        }

        _user = await UserManager.GetUserAsync(authState.User)
            ?? throw new InvalidOperationException("Unable to load the current user.");

        _email = _user.Email;
        _isAdmin = authState.User.IsInRole(Roles.Admin);
        _originalDepartmentId = _user.DepartmentId;
        _requirePassword = await UserManager.HasPasswordAsync(_user);
        _departments = await DbContext.Departments.OrderBy(d => d.Name).ToListAsync();
        _avatarVersion = DateTime.UtcNow.Ticks.ToString();
        _is2faEnabled = await UserManager.GetTwoFactorEnabledAsync(_user);
        _recoveryCodesLeft = await UserManager.CountRecoveryCodesAsync(_user);

        _deleteError = DeleteError switch
        {
            "password" => "Incorrect password. Your account was not deleted.",
            null => null,
            _ => "We couldn't delete your account. Please try again."
        };

        // Seed the form once when the interactive page initializes.
        Input.FullName = _user.FullName;
        Input.EmployeeNo = _user.EmployeeNo;
        Input.Designation = _user.Designation;
        Input.DepartmentId = _user.DepartmentId;
        Input.PhoneNumber = _user.PhoneNumber;
    }

    private async Task OnSaveProfileAsync()
    {
        if (!_isAdmin)
        {
            _message = "Only administrators can edit profile information.";
            return;
        }

        _user.FullName = Input.FullName;
        _user.EmployeeNo = Input.EmployeeNo;
        _user.Designation = Input.Designation;
        _user.DepartmentId = Input.DepartmentId;
        _user.PhoneNumber = Input.PhoneNumber;

        var result = await UserManager.UpdateAsync(_user);
        if (!result.Succeeded)
        {
            _message = $"Error: {string.Join(", ", result.Errors.Select(e => e.Description))}";
            return;
        }

        // Keep each department's running employee count in sync when the user moves.
        if (_originalDepartmentId != Input.DepartmentId)
        {
            await AdjustDepartmentCountAsync(_originalDepartmentId, delta: -1);
            await AdjustDepartmentCountAsync(Input.DepartmentId, delta: +1);
        }

        _originalDepartmentId = Input.DepartmentId;
        Logger.LogInformation("User {Email} updated their profile.", _email);
        _message = "Your settings have been saved.";
    }

    private async Task OnAvatarSelected(InputFileChangeEventArgs e)
    {
        if (!_isAdmin)
        {
            _avatarError = "Only administrators can update the profile picture.";
            return;
        }

        _avatarError = null;

        var file = e.File;
        if (file is null || file.Size == 0)
        {
            return;
        }

        var ext = Path.GetExtension(file.Name).ToLowerInvariant();
        if (!AllowedAvatarExtensions.Contains(ext))
        {
            _avatarError = "Unsupported image type. Use PNG, JPG, WEBP or GIF.";
            return;
        }

        if (file.Size > MaxAvatarBytes)
        {
            _avatarError = "Image exceeds the 5 MB limit.";
            return;
        }

        var dir = Path.Combine(Env.WebRootPath, "uploads", "avatars");
        Directory.CreateDirectory(dir);

        var storedName = $"{Guid.NewGuid():N}{ext}";
        var fullPath = Path.Combine(dir, storedName);

        await using (var source = file.OpenReadStream(MaxAvatarBytes))
        await using (var target = new FileStream(fullPath, FileMode.Create))
        {
            await source.CopyToAsync(target);
        }

        var previousAvatarPath = _user.AvatarPath;
        _user.AvatarPath = $"uploads/avatars/{storedName}";

        var result = await UserManager.UpdateAsync(_user);
        if (!result.Succeeded)
        {
            DeleteAvatarFile(_user.AvatarPath);
            _user.AvatarPath = previousAvatarPath;
            _avatarError = $"Error: {string.Join(", ", result.Errors.Select(e => e.Description))}";
            return;
        }

        DeleteAvatarFile(previousAvatarPath);
        _avatarVersion = DateTime.UtcNow.Ticks.ToString();
        _message = "Profile picture updated.";
        Logger.LogInformation("User {Email} updated their profile picture.", _email);
    }


    private async Task AdjustDepartmentCountAsync(int? departmentId, int delta)
    {
        if (departmentId is not int id)
        {
            return;
        }

        var dept = await DbContext.Departments.FirstOrDefaultAsync(d => d.Id == id);
        if (dept is not null)
        {
            dept.EmployeeCount = Math.Max(0, dept.EmployeeCount + delta);
            await DbContext.SaveChangesAsync();
        }
    }

    private void DeleteAvatarFile(string? avatarPath)
    {
        if (string.IsNullOrEmpty(avatarPath))
        {
            return;
        }

        try
        {
            var full = Path.Combine(Env.WebRootPath, avatarPath.Replace('/', Path.DirectorySeparatorChar));
            if (File.Exists(full))
            {
                File.Delete(full);
            }
        }
        catch (IOException)
        {
            // Best-effort cleanup; a leftover file is not worth failing the request.
        }
    }

    private string CurrentDepartmentName()
    {
        if (_user?.DepartmentId is not int id)
        {
            return "\u2014";
        }
        return _departments.FirstOrDefault(d => d.Id == id)?.Name ?? "\u2014";
    }

    private static string Initials(string? fullName, string? email)
    {
        var source = !string.IsNullOrWhiteSpace(fullName) ? fullName : email ?? "";
        var parts = source.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 0)
        {
            return "?";
        }
        if (parts.Length == 1)
        {
            var word = parts[0];
            return (word.Length >= 2 ? word[..2] : word).ToUpperInvariant();
        }
        return (parts[0][..1] + parts[^1][..1]).ToUpperInvariant();
    }

    private static string DisplayName(Designation d)
    {
        var member = typeof(Designation).GetMember(d.ToString()).FirstOrDefault();
        var attr = member?.GetCustomAttributes(typeof(DisplayAttribute), false).FirstOrDefault() as DisplayAttribute;
        return attr?.Name ?? d.ToString();
    }

    private sealed class ProfileModel
    {
        [Required]
        [StringLength(150)]
        [Display(Name = "Full name")]
        public string FullName { get; set; } = "";

        [Required]
        [StringLength(50)]
        [Display(Name = "Employee No.")]
        public string EmployeeNo { get; set; } = "";

        [Required]
        [Display(Name = "Designation")]
        public Designation Designation { get; set; } = Designation.Executive;

        [Required(ErrorMessage = "Please select a department.")]
        [Display(Name = "Department")]
        public int? DepartmentId { get; set; }

        [Phone]
        [Display(Name = "Phone number")]
        public string? PhoneNumber { get; set; }
    }
}
